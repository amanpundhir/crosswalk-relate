CREATE RANGE INDEX `control_adopted` FOR (n:`Control`) ON (n.`adopted`);
CREATE FULLTEXT INDEX `control_text_ft` FOR (n:`Control`) ON EACH [n.`title`, n.`text`] OPTIONS {indexConfig: {`fulltext.analyzer`: 'standard-no-stop-words',`fulltext.eventually_consistent`: false}};
CREATE RANGE INDEX `evidence_expires_at` FOR (n:`Evidence`) ON (n.`expires_at`);
CREATE VECTOR INDEX `requirement_embedding` FOR (n:`Requirement`) ON (n.`embedding`) WITH [n.`framework`] OPTIONS {indexConfig: {`vector.default_search_expansion_factor`: 3.0,`vector.dimensions`: 384,`vector.hnsw.ef_construction`: 100,`vector.hnsw.m`: 16,`vector.quantization.type`: 'BINARY',`vector.similarity_function`: 'COSINE'}};
CREATE RANGE INDEX `requirement_framework` FOR (n:`Requirement`) ON (n.`framework`);
CREATE FULLTEXT INDEX `requirement_text_ft` FOR (n:`Requirement`) ON EACH [n.`title`, n.`text`] OPTIONS {indexConfig: {`fulltext.analyzer`: 'standard-no-stop-words',`fulltext.eventually_consistent`: false}};
CREATE CONSTRAINT `agent_id` FOR (n:`Agent`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `audit_id` FOR (n:`Audit`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `control_id` FOR (n:`Control`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `decision_id` FOR (n:`Decision`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `evidence_id` FOR (n:`Evidence`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `family_id` FOR (n:`Family`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `framework_id` FOR (n:`Framework`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `meta_id` FOR (n:`Meta`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `person_id` FOR (n:`Person`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `policy_id` FOR (n:`Policy`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `proposal_id` FOR (n:`Proposal`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `requirement_id` FOR (n:`Requirement`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `system_id` FOR (n:`System`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `trackerrow_id` FOR (n:`TrackerRow`) REQUIRE (n.`id`) IS UNIQUE;
