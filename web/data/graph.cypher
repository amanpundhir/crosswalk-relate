pact and scope of adverse events are understood"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.AE-06", is_enhancement: false, title: "Information on adverse events is provided to authorized staff and tools"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.AE-07", is_enhancement: false, title: "Cyber threat intelligence and other contextual information are integrated into the analysis"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.AE-08", is_enhancement: false, title: "Incidents are declared when adverse events meet the defined incident criteria"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.CM-01", is_enhancement: false, title: "Networks and network services are monitored to find potentially adverse events"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.CM-02", is_enhancement: false, title: "The physical environment is monitored to find potentially adverse events"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.CM-03", is_enhancement: false, title: "Personnel activity and technology usage are monitored to find potentially adverse events"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.CM-06", is_enhancement: false, title: "External service provider activities and services are monitored to find potentially adverse events"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:DE.CM-09", is_enhancement: false, title: "Computing hardware and software, runtime environments, and their data are monitored to find potentially adverse events"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OC-01", is_enhancement: false, title: "The organizational mission is understood and informs cybersecurity risk management"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OC-02", is_enhancement: false, title: "Internal and external stakeholders are understood, and their needs and expectations regarding cybersecurity risk management are understood and considered"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OC-03", is_enhancement: false, title: "Legal, regulatory, and contractual requirements regarding cybersecurity - including privacy and civil liberties obligations - are understood and managed"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OC-04", is_enhancement: false, title: "Critical objectives, capabilities, and services that external stakeholders depend on or expect from the organization are understood and communicated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OC-05", is_enhancement: false, title: "Outcomes, capabilities, and services that the organization depends on are understood and communicated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OV-01", is_enhancement: false, title: "Cybersecurity risk management strategy outcomes are reviewed to inform and adjust strategy and direction"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OV-02", is_enhancement: false, title: "The cybersecurity risk management strategy is reviewed and adjusted to ensure coverage of organizational requirements and risks"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.OV-03", is_enhancement: false, title: "Organizational cybersecurity risk management performance is evaluated and reviewed for adjustments needed"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.PO-01", is_enhancement: false, title: "Policy for managing cybersecurity risks is established based on organizational context, cybersecurity strategy, and priorities and is communicated and enforced"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.PO-02", is_enhancement: false, title: "Policy for managing cybersecurity risks is reviewed, updated, communicated, and enforced to reflect changes in requirements, threats, technology, and organizational mission"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RM-01", is_enhancement: false, title: "Risk management objectives are established and agreed to by organizational stakeholders"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RM-02", is_enhancement: false, title: "Risk appetite and risk tolerance statements are established, communicated, and maintained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RM-03", is_enhancement: false, title: "Cybersecurity risk management activities and outcomes are included in enterprise risk management processes"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RM-04", is_enhancement: false, title: "Strategic direction that describes appropriate risk response options is established and communicated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RM-05", is_enhancement: false, title: "Lines of communication across the organization are established for cybersecurity risks, including risks from suppliers and other third parties"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RM-06", is_enhancement: false, title: "A standardized method for calculating, documenting, categorizing, and prioritizing cybersecurity risks is established and communicated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RM-07", is_enhancement: false, title: "Strategic opportunities (i.e., positive risks) are characterized and are included in organizational cybersecurity risk discussions"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RR-01", is_enhancement: false, title: "Organizational leadership is responsible and accountable for cybersecurity risk and fosters a culture that is risk-aware, ethical, and continually improving"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RR-02", is_enhancement: false, title: "Roles, responsibilities, and authorities related to cybersecurity risk management are established, communicated, understood, and enforced"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RR-03", is_enhancement: false, title: "Adequate resources are allocated commensurate with the cybersecurity risk strategy, roles, responsibilities, and policies"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.RR-04", is_enhancement: false, title: "Cybersecurity is included in human resources practices"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-01", is_enhancement: false, title: "A cybersecurity supply chain risk management program, strategy, objectives, policies, and processes are established and agreed to by organizational stakeholders"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-02", is_enhancement: false, title: "Cybersecurity roles and responsibilities for suppliers, customers, and partners are established, communicated, and coordinated internally and externally"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-03", is_enhancement: false, title: "Cybersecurity supply chain risk management is integrated into cybersecurity and enterprise risk management, risk assessment, and improvement processes"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-04", is_enhancement: false, title: "Suppliers are known and prioritized by criticality"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-05", is_enhancement: false, title: "Requirements to address cybersecurity risks in supply chains are established, prioritized, and integrated into contracts and other types of agreements with suppliers and other relevant third parties"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-06", is_enhancement: false, title: "Planning and due diligence are performed to reduce risks before entering into formal supplier or other third-party relationships"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-07", is_enhancement: false, title: "The risks posed by a supplier, their products and services, and other third parties are understood, recorded, prioritized, assessed, responded to, and monitored over the course of the relationship"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-08", is_enhancement: false, title: "Relevant suppliers and other third parties are included in incident planning, response, and recovery activities"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-09", is_enhancement: false, title: "Supply chain security practices are integrated into cybersecurity and enterprise risk management programs, and their performance is monitored throughout the technology product and service life cycle"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:GV.SC-10", is_enhancement: false, title: "Cybersecurity supply chain risk management plans include provisions for activities that occur after the conclusion of a partnership or service agreement"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.AM-01", is_enhancement: false, title: "Inventories of hardware managed by the organization are maintained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.AM-02", is_enhancement: false, title: "Inventories of software, services, and systems managed by the organization are maintained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.AM-03", is_enhancement: false, title: "Representations of the organization's authorized network communication and internal and external network data flows are maintained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.AM-04", is_enhancement: false, title: "Inventories of services provided by suppliers are maintained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.AM-05", is_enhancement: false, title: "Assets are prioritized based on classification, criticality, resources, and impact on the mission"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.AM-07", is_enhancement: false, title: "Inventories of data and corresponding metadata for designated data types are maintained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.AM-08", is_enhancement: false, title: "Systems, hardware, software, services, and data are managed throughout their life cycles"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.IM-01", is_enhancement: false, title: "Improvements are identified from evaluations"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.IM-02", is_enhancement: false, title: "Improvements are identified from security tests and exercises, including those done in coordination with suppliers and relevant third parties"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.IM-03", is_enhancement: false, title: "Improvements are identified from execution of operational processes, procedures, and activities"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.IM-04", is_enhancement: false, title: "Incident response plans and other cybersecurity plans that affect operations are established, communicated, maintained, and improved"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-01", is_enhancement: false, title: "Vulnerabilities in assets are identified, validated, and recorded"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-02", is_enhancement: false, title: "Cyber threat intelligence is received from information sharing forums and sources"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-03", is_enhancement: false, title: "Internal and external threats to the organization are identified and recorded"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-04", is_enhancement: false, title: "Potential impacts and likelihoods of threats exploiting vulnerabilities are identified and recorded"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-05", is_enhancement: false, title: "Threats, vulnerabilities, likelihoods, and impacts are used to understand inherent risk and inform risk response prioritization"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-06", is_enhancement: false, title: "Risk responses are chosen, prioritized, planned, tracked, and communicated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-07", is_enhancement: false, title: "Changes and exceptions are managed, assessed for risk impact, recorded, and tracked"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-08", is_enhancement: false, title: "Processes for receiving, analyzing, and responding to vulnerability disclosures are established"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-09", is_enhancement: false, title: "The authenticity and integrity of hardware and software are assessed prior to acquisition and use"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:ID.RA-10", is_enhancement: false, title: "Critical suppliers are assessed prior to acquisition"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AA-01", is_enhancement: false, title: "Identities and credentials for authorized users, services, and hardware are managed by the organization"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AA-02", is_enhancement: false, title: "Identities are proofed and bound to credentials based on the context of interactions"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AA-03", is_enhancement: false, title: "Users, services, and hardware are authenticated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AA-04", is_enhancement: false, title: "Identity assertions are protected, conveyed, and verified"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AA-05", is_enhancement: false, title: "Access permissions, entitlements, and authorizations are defined in a policy, managed, enforced, and reviewed, and incorporate the principles of least privilege and separation of duties"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AA-06", is_enhancement: false, title: "Physical access to assets is managed, monitored, and enforced commensurate with risk"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AT-01", is_enhancement: false, title: "Personnel are provided with awareness and training so that they possess the knowledge and skills to perform general tasks with cybersecurity risks in mind"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.AT-02", is_enhancement: false, title: "Individuals in specialized roles are provided with awareness and training so that they possess the knowledge and skills to perform relevant tasks with cybersecurity risks in mind"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.DS-01", is_enhancement: false, title: "The confidentiality, integrity, and availability of data-at-rest are protected"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.DS-02", is_enhancement: false, title: "The confidentiality, integrity, and availability of data-in-transit are protected"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.DS-10", is_enhancement: false, title: "The confidentiality, integrity, and availability of data-in-use are protected"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.DS-11", is_enhancement: false, title: "Backups of data are created, protected, maintained, and tested"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.IR-01", is_enhancement: false, title: "Networks and environments are protected from unauthorized logical access and usage"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.IR-02", is_enhancement: false, title: "The organization's technology assets are protected from environmental threats"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.IR-03", is_enhancement: false, title: "Mechanisms are implemented to achieve resilience requirements in normal and adverse situations"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.IR-04", is_enhancement: false, title: "Adequate resource capacity to ensure availability is maintained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.PS-01", is_enhancement: false, title: "Configuration management practices are established and applied"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.PS-02", is_enhancement: false, title: "Software is maintained, replaced, and removed commensurate with risk"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.PS-03", is_enhancement: false, title: "Hardware is maintained, replaced, and removed commensurate with risk"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.PS-04", is_enhancement: false, title: "Log records are generated and made available for continuous monitoring"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.PS-05", is_enhancement: false, title: "Installation and execution of unauthorized software are prevented"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:PR.PS-06", is_enhancement: false, title: "Secure software development practices are integrated, and their performance is monitored throughout the software development life cycle"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.CO-03", is_enhancement: false, title: "Recovery activities and progress in restoring operational capabilities are communicated to designated internal and external stakeholders"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.CO-04", is_enhancement: false, title: "Public updates on incident recovery are shared using approved methods and messaging"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.RP-01", is_enhancement: false, title: "The recovery portion of the incident response plan is executed once initiated from the incident response process"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.RP-02", is_enhancement: false, title: "Recovery actions are selected, scoped, prioritized, and performed"});
CREATE (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.RP-03", is_enhancement: false, title: "The integrity of backups and other restoration assets is verified before using them for restoration"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.RP-04", is_enhancement: false, title: "Critical mission functions and cybersecurity risk management are considered to establish post-incident operational norms"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.RP-05", is_enhancement: false, title: "The integrity of restored assets is verified, systems and services are restored, and normal operating status is confirmed"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RC.RP-06", is_enhancement: false, title: "The end of incident recovery is declared based on criteria, and incident-related documentation is completed"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.AN-03", is_enhancement: false, title: "Analysis is performed to establish what has taken place during an incident and the root cause of the incident"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.AN-06", is_enhancement: false, title: "Actions performed during an investigation are recorded, and the records' integrity and provenance are preserved"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.AN-07", is_enhancement: false, title: "Incident data and metadata are collected, and their integrity and provenance are preserved"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.AN-08", is_enhancement: false, title: "An incident's magnitude is estimated and validated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.CO-02", is_enhancement: false, title: "Internal and external stakeholders are notified of incidents"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.CO-03", is_enhancement: false, title: "Information is shared with designated internal and external stakeholders"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.MA-01", is_enhancement: false, title: "The incident response plan is executed in coordination with relevant third parties once an incident is declared"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.MA-02", is_enhancement: false, title: "Incident reports are triaged and validated"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.MA-03", is_enhancement: false, title: "Incidents are categorized and prioritized"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.MA-04", is_enhancement: false, title: "Incidents are escalated or elevated as needed"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.MA-05", is_enhancement: false, title: "The criteria for initiating incident recovery are applied"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.MI-01", is_enhancement: false, title: "Incidents are contained"}), (:Requirement {baselines: [], framework: "CSF", id: "CSF:RS.MI-02", is_enhancement: false, title: "Incidents are eradicated"});
