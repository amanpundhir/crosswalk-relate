CREATE (:Proposal {created_at: date('2026-11-24'), id: "PR-001", kind: "map", rationale: "Monthly review of accounts and permissions looks related to remote access accounts.", status: "rejected"}), (:Proposal {created_at: date('2026-11-18'), id: "PR-002", kind: "map", rationale: "Encryption of mobile computing equipment mentions protecting information.", status: "rejected"}), (:Proposal {created_at: date('2026-11-16'), id: "PR-003", kind: "map", rationale: "Scheduled restore tests exercise recovery capability, matching contingency plan testing.", status: "approved"}), (:Proposal {created_at: date('2026-11-10'), id: "PR-004", kind: "map", rationale: "Clock synchronisation by NTP is the time stamp requirement.", status: "approved"}), (:Proposal {created_at: date('2026-11-27'), id: "PR-005", kind: "map", rationale: "Policy text points staff to a single sign-on provider for shared access, which may enforce multi-factor authentication.", status: "pending"}), (:Proposal {created_at: date('2026-11-27'), id: "PR-006", kind: "map", rationale: "Reporting to the ISM as quickly as possible implies assistance and escalation support.", status: "pending"}), (:Proposal {created_at: date('2026-11-28'), id: "PR-007", kind: "map", rationale: "Keeping operating systems within one generation of current relates to baseline configuration.", status: "pending"}), (:Proposal {created_at: date('2026-11-30'), id: "PR-008", kind: "map", rationale: "Vendor risks identified during risk assessment relate to supplier assessments.", status: "pending"});
