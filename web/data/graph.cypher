CREATE (:Control {adopted: false, id: "CTRL-AOTP-1", policy: "AOTP", text: "Hiring Manager informs HR upon hire of a new employee.", title: "Hiring Manager informs HR upon hire of a new employee", vague: false}), (:Control {adopted: false, id: "CTRL-AOTP-2", policy: "AOTP", text: "HR emails IT to inform them of a new hire and their role.", title: "HR emails IT to inform them of a new hire and their role", vague: false}), (:Control {adopted: false, id: "CTRL-AOTP-3", policy: "AOTP", text: "IT creates a checklist of accounts and permission levels needed for that role.", title: "IT creates a checklist of accounts and permission levels needed for that role", vague: false}), (:Control {adopted: true, id: "CTRL-AOTP-4", owners: ["P-maya-chen"], policy: "AOTP", status: "planned", text: "The owner of each resource reviews and approves account creation and the associated permissions.", title: "The owner of each resource reviews and approves account creation and the...", vague: false}), (:Control {adopted: false, id: "CTRL-AOTP-5", policy: "AOTP", text: "IT works with the owner of each resource to set up the user.", title: "IT works with the owner of each resource to set up the user", vague: false}), (:Control {adopted: false, id: "CTRL-AOTP-6", policy: "AOTP", text: "Hiring Manager notifies HR when an employee has been terminated.", title: "Hiring Manager notifies HR when an employee has been terminated", vague: false}), (:Control {adopted: false, id: "CTRL-AOTP-7", policy: "AOTP", text: "HR sends a weekly email report to IT summarizing list of users terminated and instructs IT to disable their access.", title: "HR sends a weekly email report to IT summarizing list of users terminated and...", vague: false}), (:Control {adopted: true, id: "CTRL-AOTP-8", owners: ["P-dana-okafor"], policy: "AOTP", status: "implemented", text: "IT terminates access within five business days from receipt of notification.", title: "IT terminates access within five business days from receipt of notification", vague: false}), (:Control {adopted: true, id: "CTRL-AOTP-9", owners: ["P-lena-brandt"], policy: "AOTP", status: "partial", text: "Hiring Manager will inform HR of a change in role.", title: "Hiring Manager will inform HR of a change in role", vague: false}), (:Control {adopted: false, id: "CTRL-AOTP-10", policy: "AOTP", text: "HR and IT will follow the same steps as outlined in the onboarding and offboarding procedures.", title: "HR and IT will follow the same steps as outlined in the onboarding and...", vague: false}), (:Control {adopted: true, id: "CTRL-AOTP-11", owners: ["P-dana-okafor"], policy: "AOTP", status: "implemented", text: "Each month, IT and HR will review accounts and permission levels for accuracy.", title: "Each month, IT and HR will review accounts and permission levels for accuracy", vague: false}), (:Control {adopted: false, id: "CTRL-AP-1", policy: "AP", text: "Information systems must be consistently available to conduct and support business operations.", title: "Information systems must be consistently available to conduct and support...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-2", policy: "AP", text: "Information systems must have a defined availability classification, with appropriate controls enabled and incorporated into development and production processes based on this classification.", title: "Information systems must have a defined availability classification, with...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-3", policy: "AP", text: "System and network failures must be reported promptly to the organization’s lead for Information Technology (IT) or designated IT operations manager.", title: "System and network failures must be reported promptly to the organization’s...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-4", policy: "AP", text: "Users must be notified of scheduled outages (e.g., system maintenance) that require periods of downtime. This notification must specify the date and time of the system maintenance, expected duration, and anticipated system or service resumption time.", title: "Users must be notified of scheduled outages (e.g., system maintenance) that...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-5", policy: "AP", text: "Prior to production use, each new or significantly modified application must have a completed risk assessment that includes availability risks. Risk assessments must be completed in accordance with the Risk Assessment Policy (reference (a)).", title: "Prior to production use, each new or significantly modified application must...", vague: true}), (:Control {adopted: false, id: "CTRL-AP-6", policy: "AP", text: "Capacity management and load balancing techniques must be used, as deemed necessary, to help minimize the risk and impact of system failures.", title: "Capacity management and load balancing techniques must be used, as deemed...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-7", policy: "AP", text: "All sensitive data can be restored within a reasonable time period.", title: "All sensitive data can be restored within a reasonable time period", vague: false}), (:Control {adopted: true, id: "CTRL-AP-8", owners: ["P-dana-okafor"], policy: "AP", status: "implemented", text: "Full backups of critical resources are performed on at least a weekly basis.", title: "Full backups of critical resources are performed on at least a weekly basis", vague: false}), (:Control {adopted: true, id: "CTRL-AP-9", owners: ["P-omar-haddad"], policy: "AP", status: "implemented", text: "Incremental backups for critical resources are performed on at least a daily basis.", title: "Incremental backups for critical resources are performed on at least a daily...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-10", policy: "AP", text: "Backups and associated media are maintained for a minimum of thirty (30) days and retained for at least one (1) year, or in accordance with legal and regulatory requirements.", title: "Backups and associated media are maintained for a minimum of thirty (30) days...", vague: false}), (:Control {adopted: true, id: "CTRL-AP-11", owners: ["P-omar-haddad"], policy: "AP", status: "implemented", text: "Backups are stored off-site with multiple points of redundancy and protected using encryption and key management.", title: "Backups are stored off-site with multiple points of redundancy and protected...", vague: false}), (:Control {adopted: true, id: "CTRL-AP-12", owners: ["P-omar-haddad"], policy: "AP", status: "partial", text: "Tests of backup data must be conducted once per quarter. Tests of configurations must be conducted twice per year.", title: "Tests of backup data must be conducted once per quarter. Tests of...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-13", policy: "AP", text: "Network infrastructure that supports critical resources must have system-level redundancy (including but not limited to a secondary power supply, backup disk-array, and secondary computing system). Critical core components (including but not limited to routers, switches, and other devices linked to Service Level Agreements (SLAs)) must have an actively maintained spare. SLAs must require parts replacement within twenty-four (24) hours.", title: "Network infrastructure that supports critical resources must have system-level...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-14", policy: "AP", text: "Servers that support critical resources must have redundant power supplies and network interface cards. All servers must have an actively maintained spare. SLAs must require parts replacement within twenty-four (24) hours.", title: "Servers that support critical resources must have redundant power supplies and...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-15", policy: "AP", text: "Servers classified as high availability must use disk mirroring.", title: "Servers classified as high availability must use disk mirroring", vague: false}), (:Control {adopted: false, id: "CTRL-AP-16", policy: "AP", text: "Recovery time and data loss limits are defined in Table 3.", title: "Recovery time and data loss limits are defined in Table 3", vague: true}), (:Control {adopted: false, id: "CTRL-AP-17", policy: "AP", text: "Recovery time requirements and data loss limits must be adhered to with specific documentation in the plan.", title: "Recovery time requirements and data loss limits must be adhered to with...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-18", policy: "AP", text: "Company and/or external critical resources, personnel, and necessary corrective actions must be specifically identified.", title: "Company and/or external critical resources, personnel, and necessary corrective...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-19", policy: "AP", text: "Specific responsibilities and tasks for responding to emergencies and resuming business operations must be included in the plan.", title: "Specific responsibilities and tasks for responding to emergencies and resuming...", vague: false}), (:Control {adopted: false, id: "CTRL-AP-20", policy: "AP", text: "All applicable legal and regulatory requirements must be satisfied. +-------------------+------------------+---------------+-------------------+------------------+ |Availability | Availability | Scheduled | Recovery Time | Data Loss or | |Classification | Requirements | Outage | Requirements | Impact Loss | +===================+==================+===============+===================+==================+ | High | High to | 30 minutes | 1 hour | Minimal | | | Continuous | | | | +-------------------+------------------+---------------+-------------------+------------------+ | | | | | | +-------------------+------------------+---------------+-------------------+------------------+ | Medium | Standard | 2 hours | 4 hours | Some data loss | | | Availability | | | is tolerated if | | | | | | it results in | | | | | | quicker | | | | | | restoration | +-------------------+------------------+---------------+-------------------+------------------+ | | | | | | +-------------------+------------------+---------------+-------------------+------------------+ | Low | Limited | 4 hours | Next | Some data loss | | | Availability | | business day | is tolerated if | | | | | | it results in | | | | | | quicker | | | | | | restoration | +-------------------+------------------+---------------+-------------------+------------------+ Table 3: Recovery Time and Data Loss Limits", title: "All applicable legal and regulatory requirements must be satisfied...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-1", policy: "ASP", text: "The organization must ensure that all applications it develops and/or acquires are securely configured and managed.", title: "The organization must ensure that all applications it develops and/or acquires...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-2", policy: "ASP", text: "Data handled and managed by the application must be classified in accordance with the Data Classification Policy (reference (a)).", title: "Data handled and managed by the application must be classified in accordance...", vague: true}), (:Control {adopted: false, id: "CTRL-ASP-3", policy: "ASP", text: "If the application processes confidential information, a confidential record banner must be prominently displayed which highlights the type of confidential data being accessed (e.g., personally-identifiable information (PII), protected health information (PHI), etc.)", title: "If the application processes confidential information, a confidential record...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-4", policy: "ASP", text: "Sensitive data, especially data specifically restricted by law or policy (e.g., social security numbers, passwords, and credit card data) should not be displayed in plaintext.", title: "Sensitive data, especially data specifically restricted by law or policy (e.g...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-5", policy: "ASP", text: "Ensure that applications validate input properly and restrictively, allowing only those types of input that are known to be correct. Examples include, but are not limited to cross-site scripting, buffer overflow errors, and injection flaws.", title: "Ensure that applications validate input properly and restrictively, allowing...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-6", policy: "ASP", text: "Ensure that applications execute proper error handling so that errors will not provide detailed system information to an unprivileged user, deny service, impair security mechanisms, or crash the system.", title: "Ensure that applications execute proper error handling so that errors will not...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-7", policy: "ASP", text: "Where possible, authorize access to applications by affiliation, membership or employment, rather than by individual. Provide an automated review of authorizations on a regular basis, where possible.", title: "Where possible, authorize access to applications by affiliation, membership or...", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-8", owners: ["P-sofia-lindqvist"], policy: "ASP", status: "implemented", text: "Ensure that applications encrypt data at rest and in transit.", title: "Ensure that applications encrypt data at rest and in transit", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-9", owners: ["P-omar-haddad"], policy: "ASP", status: "implemented", text: "Implement application logging to the extent practical. Retain logs of all users and access events for at least 14 days.", title: "Implement application logging to the extent practical. Retain logs of all users...", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-10", owners: ["P-tomas-ferreira"], policy: "ASP", status: "implemented", text: "Qualified peers conduct security reviews of code for all new or significantly modified applications; particularly, those that affect the collection, use, and/or display of confidential data. Document all actions taken.", title: "Qualified peers conduct security reviews of code for all new or significantly...", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-11", owners: ["P-nia-walker"], policy: "ASP", status: "implemented", text: "Implement a change management process for changes to existing software applications.", title: "Implement a change management process for changes to existing software...", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-12", owners: ["P-hugo-silva"], policy: "ASP", status: "partial", text: "Standard configuration of the application must be documented.", title: "Standard configuration of the application must be documented", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-13", policy: "ASP", text: "Default passwords used within the application, such as for administrative control panels or integration with databases must be changed immediately upon installation.", title: "Default passwords used within the application, such as for administrative...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-14", policy: "ASP", text: "Applications must require complex passwords in accordance with current security best practices (at least 8 characters in length, combination of alphanumeric upper/lowercase characters and symbols).", title: "Applications must require complex passwords in accordance with current security...", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-15", owners: ["P-sofia-lindqvist"], policy: "ASP", status: "implemented", text: "During development and testing, applications must not have access to live data.", title: "During development and testing, applications must not have access to live data", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-16", policy: "ASP", text: "Only applications that are supported by an approved vendor shall be procured and used.", title: "Only applications that are supported by an approved vendor shall be procured...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-17", policy: "ASP", text: "Full support contracts must be arranged with the application vendor for full life-cycle support.", title: "Full support contracts must be arranged with the application vendor for full...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-18", policy: "ASP", text: "No custom modifications may be applied to the application without confirmation that the vendor can continue to provide support.", title: "No custom modifications may be applied to the application without confirmation...", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-19", owners: ["P-hugo-silva"], policy: "ASP", status: "implemented", text: "Updates, patches and configuration changes issued by the vendor shall be implemented as soon as possible.", title: "Updates, patches and configuration changes issued by the vendor shall be...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-20", policy: "ASP", text: "A full review of applications and licenses shall be completed at least annually, as part of regular software reviews.", title: "A full review of applications and licenses shall be completed at least...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-21", policy: "ASP", text: "New or major application releases must have a full assessment prior to approval of the change control documentation and/or release into the production environment.", title: "New or major application releases must have a full assessment prior to approval...", vague: false}), (:Control {adopted: true, id: "CTRL-ASP-22", owners: ["P-amara-osei"], policy: "ASP", status: "partial", text: "Third-party or acquired applications must have a full assessment prior to deployment.", title: "Third-party or acquired applications must have a full assessment prior to...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-23", policy: "ASP", text: "Software releases must have an appropriate assessment, as determined by the organization’s information security manager, with specific evaluation criteria based on the security risks inherent in the changes made to the application’s functionality and/or architecture.", title: "Software releases must have an appropriate assessment, as determined by the...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-24", policy: "ASP", text: "Emergency releases may forego security assessments and carry the assumed risk until a proper assessment can be conducted. Emergency releases must be approved by the Chief Information Officer or designee.", title: "Emergency releases may forego security assessments and carry the assumed risk...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-25", policy: "ASP", text: "High - issues categorized as high risk must be fixed immediately, otherwise alternate mitigation strategies must be implemented to limit exposure before deployment. Applications with high risk issues are subject to being taken off-line or denied release into the production environment.", title: "High - issues categorized as high risk must be fixed immediately, otherwise...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-26", policy: "ASP", text: "Medium - issues categorized as medium risk must be reviewed to determine specific items to be mitigated. Actions to implement mitigations must be scheduled. Applications with medium risk issues may be taken off-line or denied release into the production environment based on the number of issues; multiple issues may increase the risk to an unacceptable level. Issues may be fixed in patch releases unless better mitigation options are present.", title: "Medium - issues categorized as medium risk must be reviewed to determine...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-27", policy: "ASP", text: "Low - issues categorized as low risk must be reviewed to determine specific items to be mitigated. Actions to implement mitigations must be scheduled.", title: "Low - issues categorized as low risk must be reviewed to determine specific...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-28", policy: "ASP", text: "Testing is required to validate fixes and/or mitigation strategies for any security vulnerabilities classified as Medium risk or greater.", title: "Testing is required to validate fixes and/or mitigation strategies for any...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-29", policy: "ASP", text: "Full - comprised of tests for all known web application vulnerabilities using both automated and manual tools based on the OWASP Testing Guide (reference (c)). A full assessment must leverage manual penetration testing techniques to validate discovered vulnerabilities to determine the overall risk of any and all discovered issues.", title: "Full - comprised of tests for all known web application vulnerabilities using...", vague: true}), (:Control {adopted: false, id: "CTRL-ASP-30", policy: "ASP", text: "Quick - consists of an automated scan of an application for, at a minimum, the OWASP Top Ten web application security risks (reference (d)).", title: "Quick - consists of an automated scan of an application for, at a minimum, the...", vague: true}), (:Control {adopted: false, id: "CTRL-ASP-31", policy: "ASP", text: "Targeted - verifies vulnerability remediation changes or new application functionality.", title: "Targeted - verifies vulnerability remediation changes or new application...", vague: false}), (:Control {adopted: false, id: "CTRL-ASP-32", policy: "ASP", text: "To counter the risk of unauthorized access, the organization maintains a Data Center Security Policy (reference (c)).", title: "To counter the risk of unauthorized access, the organization maintains a Data...", vague: true}), (:Control {adopted: false, id: "CTRL-ASP-33", policy: "ASP", text: "Security requirements for the software development life cycle, including system development, acquisition and maintenance are defined in the Software Development Lifecycle Policy (reference (d)).", title: "Security requirements for the software development life cycle, including system...", vague: true}), (:Control {adopted: false, id: "CTRL-ASP-34", policy: "ASP", text: "Security requirements for handling information security incidents are defined in the Security Incident Response Policy (reference (e)).", title: "Security requirements for handling information security incidents are defined...", vague: true}), (:Control {adopted: false, id: "CTRL-ASP-35", policy: "ASP", text: "Disaster recovery and business continuity management policy is defined in the Disaster Recovery Policy (reference (f)).", title: "Disaster recovery and business continuity management policy is defined in the...", vague: true}), (:Control {adopted: false, id: "CTRL-ASP-36", policy: "ASP", text: "Requirements for information system availability and redundancy are defined in the System Availability Policy (reference (g)).", title: "Requirements for information system availability and redundancy are defined in...", vague: true}), (:Control {adopted: false, id: "CTRL-BCP-1", policy: "BCP", text: "Each manager is required to perform a business risk assessment and business impact analysis for each key business system within their area of responsibility.", title: "Each manager is required to perform a business risk assessment and business...", vague: false}), (:Control {adopted: false, id: "CTRL-BCP-2", policy: "BCP", text: "The business risk assessment must identify and define the criticality of key business systems and the repositories that contain the relevant and necessary data for the key business system.", title: "The business risk assessment must identify and define the criticality of key...", vague: false}), (:Control {adopted: false, id: "CTRL-BCP-3", policy: "BCP", text: "The business risk assessment must define and document the Disaster Recovery Plan (DRP) for their area of responsibility. Each DRP shall include: | Key business processes. | Applicable risk to availability. | Prioritization of recovery. | Recovery Time Objectives (RTOs). | Recovery Point Objectives (RPOs).", title: "The business risk assessment must define and document the Disaster Recovery...", vague: false}), (:Control {adopted: true, id: "CTRL-BCP-4", owners: ["P-tomas-ferreira"], policy: "BCP", status: "partial", text: "Each key business system must have a documented DRP to provide guidance when hardware, software, or networks become critically dysfunctional or cease to function (short and long term outages).", title: "Each key business system must have a documented DRP to provide guidance when...", vague: false}), (:Control {adopted: false, id: "CTRL-BCP-5", policy: "BCP", text: "Each DRP must include an explanation of the magnitude of information or system unavailability in the event of an outage and the process that would be implemented to continue business operations during the outage. Where feasible, the DRP must consider the use of alternative, off-site computer operations (cold, warm, hot sites).", title: "Each DRP must include an explanation of the magnitude of information or system...", vague: false}), (:Control {adopted: false, id: "CTRL-BCP-6", policy: "BCP", text: "Each plan must be reviewed against the organization’s strategy, objectives, culture, and ethics, as well as policy, legal, statutory and regulatory requirements.", title: "Each plan must be reviewed against the organization’s strategy, objectives...", vague: false}), (:Control {adopted: false, id: "CTRL-BCP-7", policy: "BCP", text: "Each DRP must include: | An emergency mode operations plan for continuing operations in the event of temporary hardware, software, or network outages. | A recovery plan for returning business functions and services to normal on-site operations. | Procedures for periodic testing, review, and revisions of the DRP for all affected business systems, as a group and/or individually.", title: "Each DRP must include", vague: false}), (:Control {adopted: false, id: "CTRL-BCP-8", policy: "BCP", text: "Each system owner must implement a data backup and restoration plan.", title: "Each system owner must implement a data backup and restoration plan", vague: false}), (:Control {adopted: false, id: "CTRL-BCP-9", policy: "BCP", text: "Each data backup and restoration plan must identify: | The data custodian for the system. | The backup schedule of each system. | Where backup media is to be stored and secured, as well as how access is maintained. | Who may remove backup media and transfer it to storage. | Appropriate restoration procedures to restore key business system data from backup media to the system. | The restoration testing plan and frequency of testing to confirm the effectiveness of the plan. | The method for restoring encrypted backup media.", title: "Each data backup and restoration plan must identify", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-1", policy: "COCP", text: "Employees should have an understanding of and comply with all environmental, safety, and fair dealing laws. When performing their job duty and dealing with the company’s products, finances, critical information, & public image, employees are expected to be ethical and responsible. If an employee is unsure of whether a contemplated action is permitted by law or Company policy, they should seek advice from the resource manager.", title: "Employees should have an understanding of and comply with all environmental...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-2", policy: "COCP", text: "Employees should respect their colleagues. Discriminatory behavior, harassment, or victimization will not be tolerated.", title: "Employees should respect their colleagues. Discriminatory behavior, harassment...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-3", policy: "COCP", text: "Company property, both material or intangible, should be treated with respect and care. Employees and contractors: | Should not misuse company equipment | Should respect all intangible property, including trademarks, copyright, information, reports, and other property. These materials should be used only to complete job duties. | Should protect company facilities and other material property from damage and vandalism, whenever possible.", title: "Company property, both material or intangible, should be treated with respect...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-4", policy: "COCP", text: "When in the workplace, employees must present themselves in an appropriate & professional manner. They should abide by the company dress code.", title: "When in the workplace, employees must present themselves in an appropriate &...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-5", policy: "COCP", text: "Employees are discouraged from accepting gifts from clients or partners. Briberies are prohibited for the benefit of any external or internal party.", title: "Employees are discouraged from accepting gifts from clients or partners...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-6", policy: "COCP", text: "Employees should fulfill their job duties with integrity and respect towards all individuals involved.", title: "Employees should fulfill their job duties with integrity and respect towards...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-7", policy: "COCP", text: "Supervisors and managers may not use abuse their authority. Competency and workload should be taken into account when delegating duties to team members.", title: "Supervisors and managers may not use abuse their authority. Competency and...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-8", policy: "COCP", text: "Team members are expected to follow their leaders’ instructions and complete their duties with thoughtfulness and in a timely manner.", title: "Team members are expected to follow their leaders’ instructions and complete...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-9", policy: "COCP", text: "Employees should be punctual when coming to and leaving from work and follow the schedule determined by their hiring manager. Exceptions can be made for occasions that prevent employees from following standard working hours or days, with approval from their hiring manager.", title: "Employees should be punctual when coming to and leaving from work and follow...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-10", policy: "COCP", text: "Employees should avoid any personal, financial, or other interests that might compete with their job duties.", title: "Employees should avoid any personal, financial, or other interests that might...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-11", policy: "COCP", text: "Employees should be friendly with their colleagues and open to collaboration. They should not disrupt the workplace or present obstacles to their colleagues’ work.", title: "Employees should be friendly with their colleagues and open to collaboration...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-12", policy: "COCP", text: "Colleagues, supervisors, or team members must be open to communication amongst each other.", title: "Colleagues, supervisors, or team members must be open to communication amongst...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-13", policy: "COCP", text: "We expect employees to not abuse their employment benefits. This can refer to time off, insurance, facilities, subscriptions, or other benefits our company offers. Refer to Human Resources for more information on benefits.", title: "We expect employees to not abuse their employment benefits. This can refer to...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-14", policy: "COCP", text: "All employees must comply with company policies. Questions should be directed to their hiring managers and/or Human Resources.", title: "All employees must comply with company policies. Questions should be directed...", vague: false}), (:Control {adopted: false, id: "CTRL-COCP-15", policy: "COCP", text: "Repeated or intentional violation of the Code of Conduct Policy will be met with disciplinary action. Consequences will vary depending on the violation, but can include: | demotion | reprimand | suspension or termination | detraction of benefits for a definite or indefinite time ii. Cases of corruption, theft, embezzlement, or other unlawful behavior may call for legal action.", title: "Repeated or intentional violation of the Code of Conduct Policy will be met...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-1", policy: "CP", text: "Lock and secure confidential information at all times", title: "Lock and secure confidential information at all times", vague: false}), (:Control {adopted: false, id: "CTRL-CP-2", policy: "CP", text: "Safely dispose (i.e. shred) documents when no longer needed", title: "Safely dispose (i.e. shred) documents when no longer needed", vague: false}), (:Control {adopted: false, id: "CTRL-CP-3", policy: "CP", text: "View confidential information only on secure devices", title: "View confidential information only on secure devices", vague: true}), (:Control {adopted: false, id: "CTRL-CP-4", policy: "CP", text: "Disclose information only when authorized and necessary", title: "Disclose information only when authorized and necessary", vague: true}), (:Control {adopted: false, id: "CTRL-CP-5", policy: "CP", text: "Do not use confidential information for personal gain, benefit, or profit", title: "Do not use confidential information for personal gain, benefit, or profit", vague: false}), (:Control {adopted: false, id: "CTRL-CP-6", policy: "CP", text: "Do not disclose confidential information to anyone outside the company or to anyone within the company who does not have appropriate privileges", title: "Do not disclose confidential information to anyone outside the company or to...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-7", policy: "CP", text: "Do not store confidential information or replicates of confidential information in unsecured manners (i.e. on unsecured devices)", title: "Do not store confidential information or replicates of confidential information...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-8", policy: "CP", text: "Do not remove confidential documents from company's premises unless absolutely necessary to move", title: "Do not remove confidential documents from company's premises unless absolutely...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-9", policy: "CP", text: "The Hiring Manager should confirm the off-boarding procedure has been completed by final date of employment.", title: "The Hiring Manager should confirm the off-boarding procedure has been completed...", vague: false});
CREATE (:Control {adopted: false, id: "CTRL-CP-10", policy: "CP", text: "The company will take the following measures to ensure protection of confidential information: | Store and lock paper documents | Encrypt electronic information and implement appropriate technical measures to safeguard databases | Require employees to sign non-disclosure/non-compete agreements | Consult with senior management before granting employees access to certain confidential information", title: "The company will take the following measures to ensure protection of...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-11", policy: "CP", text: "Under certain legitimate conditions, confidential information may need to be disclosed. Examples include: | If a regulatory agency requests information as part of an audit or investigation | If the company requires disclosing information (within legal bounds) as part of a venture or partnership", title: "Under certain legitimate conditions, confidential information may need to be...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-12", policy: "CP", text: "In such cases, employee must request and receive prior written authorization from their hiring manager before disclosing confidential information to any third parties.", title: "In such cases, employee must request and receive prior written authorization...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-13", policy: "CP", text: "Employees who violate the confidentiality policy will face disciplinary and possible legal action.", title: "Employees who violate the confidentiality policy will face disciplinary and...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-14", policy: "CP", text: "A suspected breach of this policy will trigger an investigation. Intentional violations will be met with termination and repeated unintentional violations may also face termination.", title: "A suspected breach of this policy will trigger an investigation. Intentional...", vague: false}), (:Control {adopted: false, id: "CTRL-CP-15", policy: "CP", text: "This policy is binding even after the termination of employment.", title: "This policy is binding even after the termination of employment", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-1", policy: "CRP", text: "Confirms that the entire risk assessment and risk treatment process has been carried out according to the Risk Assessment Policy.", title: "Confirms that the entire risk assessment and risk treatment process has been...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-2", policy: "CRP", text: "The purpose of the risk assessment was to identify all information systems their vulnerabilities, and threats that could exploit vulnerabilities. These parameters were further evaluated in order to establish the criticality of individual risks.", title: "The purpose of the risk assessment was to identify all information systems...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-3", policy: "CRP", text: "The purpose of the risk treatment was to define the systematic means of reducing or controlling the risks identified in the risk assessment.", title: "The purpose of the risk treatment was to define the systematic means of...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-4", policy: "CRP", text: "All risk assessment and treatment activities were completed within the scope of the organization’s information security program.", title: "All risk assessment and treatment activities were completed within the scope of...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-5", policy: "CRP", text: "The risk assessment was implemented in the period from [day/month/year] to [day/month/year]. The risk treatment was implemented from [day/month/year] to [day/month/year]. Final reports were prepared during [specify period].", title: "The risk assessment was implemented in the period from [day/month/year] to...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-6", policy: "CRP", text: "The risk assessment and risk treatment process was managed by [person responsible for managing the risk assessment process] with expert assistance provided by [person or company responsible for assistance].", title: "The risk assessment and risk treatment process was managed by [person...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-7", policy: "CRP", text: "During the risk assessment, information was collected through questionnaires and interviews with responsible persons, namely the asset owners across organizational units.", title: "During the risk assessment, information was collected through questionnaires...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-8", policy: "CRP", text: "All information systems and their owners were identified.", title: "All information systems and their owners were identified", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-9", policy: "CRP", text: "Threats were identified for each asset, and corresponding vulnerabilities were identified for each threat.", title: "Threats were identified for each asset, and corresponding vulnerabilities were...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-10", policy: "CRP", text: "Risk owners were identified for each risk.", title: "Risk owners were identified for each risk", vague: true}), (:Control {adopted: false, id: "CTRL-CRP-11", policy: "CRP", text: "Consequences of the loss of confidentiality, integrity and availability were evaluated using a score from 0 to 2, with 0 being the lowest rating and 2 being the highest rating.", title: "Consequences of the loss of confidentiality, integrity and availability were...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-12", policy: "CRP", text: "The likelihood of risk occurrence (i.e. that the threat will exploit the vulnerability) was evaluated using a score from 0 to 2, with 0 being the lowest rating and 2 being the highest rating.", title: "The likelihood of risk occurrence (i.e. that the threat will exploit the...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-13", policy: "CRP", text: "The level of risk was calculated by adding up the consequence and likelihood.", title: "The level of risk was calculated by adding up the consequence and likelihood", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-14", policy: "CRP", text: "Risks with a score of 3 or 4 were determined to be unacceptable risks.", title: "Risks with a score of 3 or 4 were determined to be unacceptable risks", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-15", policy: "CRP", text: "For each unacceptable risk, a risk treatment option was considered, and appropriate information security controls were selected.", title: "For each unacceptable risk, a risk treatment option was considered, and...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-16", policy: "CRP", text: "After controls were applied, residual risks were assessed.", title: "After controls were applied, residual risks were assessed", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-17", policy: "CRP", text: "Risk Assessment Table (Appendix A): for each combination of systems , vulnerabilities and threats, this table shows the values for consequence and likelihood, and calculates the risk.", title: "Risk Assessment Table (Appendix A): for each combination of systems...", vague: false}), (:Control {adopted: false, id: "CTRL-CRP-18", policy: "CRP", text: "Risk Treatment Table (Appendix B): defines the options for risk treatment, selection of controls for each unacceptable risk, and the level of residual risk.", title: "Risk Treatment Table (Appendix B): defines the options for risk treatment...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-1", policy: "DCP", text: "If classified information is received from outside the organization, the person who receives the information must classify it in accordance with the rules prescribed in this policy. The person thereby will become the owner of the information.", title: "If classified information is received from outside the organization, the person...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-2", policy: "DCP", text: "If classified information is received from outside the organization and handled as part of business operations activities (e.g., customer data on provided cloud services), the information classification, as well as the owner of such information, must be made in accordance with the specifications of the respective customer service agreement and other legal requirements.", title: "If classified information is received from outside the organization and handled...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-3", policy: "DCP", text: "The value of the information, based on impacts identified during the risk assessment process. More information on risk assessments is defined in the Risk Assessment Policy (reference (a)).", title: "The value of the information, based on impacts identified during the risk...", vague: true}), (:Control {adopted: false, id: "CTRL-DCP-4", policy: "DCP", text: "Sensitivity and criticality of the information, based on the highest risk calculated for each information item during the risk assessment.", title: "Sensitivity and criticality of the information, based on the highest risk...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-5", policy: "DCP", text: "Legal, regulatory and contractual obligations. +-------------------+------------------+---------------------------+---------------------------+ |Confidentiality| Label | Classification | Access | | Level | | Criteria | Restrictions | +===================+==================+===========================+============================+ | Public | For Public | Making the information | Information is available | | | Release | public will not harm | to the public. | | | | the organization in | | | | | any way. | | +-------------------+------------------+---------------------------+---------------------------+ | | | | | +-------------------+------------------+---------------------------+---------------------------+ | Internal Use | Internal Use | Unauthorized access | Information is available | | | | may cause minor damage | to all employees and | | | | and/or inconvenience | authorized third parties. | | | | to the organization. | +-------------------+------------------+---------------------------+---------------------------+ | | | | | +-------------------+------------------+---------------------------+---------------------------+ | Restricted | Restricted | Unauthorized access to | Information is available | | | | information may cause | to a specific group of | | | | considerable damage to | employees and authhorized | | | | the business and/or | third parties. | | | | the organization's | | | | | reputation. | | +-------------------+------------------+---------------------------+---------------------------+ | | | | | +-------------------+------------------+---------------------------+---------------------------+ | Confidential |Confidential | Unauthorized access to | Information is available | | | | information may cause | only to specific indivi- | | | | catastrophic damage to | duals in the | | | | business and/or the | organization. | | | | organization's reputation.| | +-------------------+------------------+---------------------------+---------------------------+ Table 3: Information Confidentiality Levels &nbsp; d. Information must be classified based on confidentiality levels as defined in Table 3. e. Information and information system owners should try to use the lowest confidentiality level that ensures an adequate level of protection, thereby avoiding unnecessary production costs. f. Information classified as “Restricted” or “Confidential” must be accompanied by a list of authorized persons in which the information owner specifies the names or job functions of persons who have the right to access that information. g. Information classified as “Internal Use” must be accompanied by a list of authorized persons only if individuals outside the organization will have access to the document. h. Information and information system owners must review the confidentiality level of their information assets every five years and assess whether the confidentiality level should be changed. Wherever possible, confidentiality levels should be lowered.", title: "Legal, regulatory and contractual obligations...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-6", policy: "DCP", text: "For cloud-based software services provided to customers, system owners under the company’s control must also review the confidentiality level of their information systems after service agreement changes or after a customer’s formal notification. Where allowed by service agreements, confidentiality levels should be lowered.", title: "For cloud-based software services provided to customers, system owners under...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-7", policy: "DCP", text: "Paper documents: the confidentiality level is indicated on the top and bottom of each document page; it is also indicated on the front of the cover or envelope carrying such a document as well as on the filing folder in which the document is stored. If a document is not labeled, its default classification is Internal Use.", title: "Paper documents: the confidentiality level is indicated on the top and bottom...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-8", policy: "DCP", text: "Electronic documents: the confidentiality level is indicated on the top and bottom of each document page. If a document is not labeled, its default classification is Internal Use.", title: "Electronic documents: the confidentiality level is indicated on the top and...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-9", policy: "DCP", text: "Information systems: the confidentiality level in applications and databases must be indicated on the system access screen, as well as on the screen when displaying such information.", title: "Information systems: the confidentiality level in applications and databases...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-10", policy: "DCP", text: "Electronic mail: the confidentiality level is indicated in the first line of the email body. If it is not labeled, its default classification is “Internal Use”.", title: "Electronic mail: the confidentiality level is indicated in the first line of...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-11", policy: "DCP", text: "Electronic storage media (disks, memory cards, etc.): the confidentiality level must be indicated on the top surface of the media. If it is not labeled, its default classification is “Internal Use”.", title: "Electronic storage media (disks, memory cards, etc.): the confidentiality level...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-12", policy: "DCP", text: "Information transmitted orally: the confidentiality level should be mentioned before discussing information during face-to-face communication, by telephone, or any other means of oral communication.", title: "Information transmitted orally: the confidentiality level should be mentioned...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-13", policy: "DCP", text: "All persons accessing classified information must follow the guidelines listed in Appendix A, “Handling of Classified Information.”", title: "All persons accessing classified information must follow the guidelines listed...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-14", policy: "DCP", text: "All persons accessing classified information must complete and submit a Confidentiality Statement to their immediate supervisor or company point-of-contact. A sample Confidentiality Statement is in Appendix B.", title: "All persons accessing classified information must complete and submit a...", vague: false}), (:Control {adopted: false, id: "CTRL-DCP-15", policy: "DCP", text: "Incidents related to the improper handling of classified information must be reported in accordance with the Security Incident Management Policy (reference (b)).", title: "Incidents related to the improper handling of classified information must be...", vague: true}), (:Control {adopted: false, id: "CTRL-DP-1", policy: "DP", text: "[list all data center locations and secure areas under the organization’s control]", title: "[list all data center locations and secure areas under the organization’s...", vague: false}), (:Control {adopted: false, id: "CTRL-DP-2", policy: "DP", text: "Each data center and secure area must have a manager assigned. The manager’s name must be documented in the organization’s records. In the case of any on-prem data centers, the manager’s name must also be posted in and near the secure area.", title: "Each data center and secure area must have a manager assigned. The manager’s...", vague: false}), (:Control {adopted: true, id: "CTRL-DP-3", owners: ["P-ivan-petrov"], policy: "DP", status: "implemented", text: "Each secure area must be clearly marked. Access to the secure area must be controlled by at least a locked door. A visitor access log must be clearly marked and easily accessible just inside the door.", title: "Each secure area must be clearly marked. Access to the secure area must be...", vague: false}), (:Control {adopted: false, id: "CTRL-DP-4", policy: "DP", text: "Obtain access to secure areas in accordance with reference a.", title: "Obtain access to secure areas in accordance with reference a", vague: false}), (:Control {adopted: false, id: "CTRL-DP-5", policy: "DP", text: "Only enter and remain in secure areas when escorted by a designated employee. The employee must stay with the visitor during their entire stay inside the secure area.", title: "Only enter and remain in secure areas when escorted by a designated employee...", vague: false}), (:Control {adopted: false, id: "CTRL-DP-6", policy: "DP", text: "Log the precise time of entry and exit in the visitor access log.", title: "Log the precise time of entry and exit in the visitor access log", vague: false}), (:Control {adopted: false, id: "CTRL-DP-7", policy: "DP", text: "Photography, or video or audio recordings of any kind.", title: "Photography, or video or audio recordings of any kind", vague: false}), (:Control {adopted: false, id: "CTRL-DP-8", policy: "DP", text: "Connection of any electrical device to a power supply, unless specifically authorized by the responsible person.", title: "Connection of any electrical device to a power supply, unless specifically...", vague: false}), (:Control {adopted: false, id: "CTRL-DP-9", policy: "DP", text: "Unauthorized usage of or tampering with any installed equipment.", title: "Unauthorized usage of or tampering with any installed equipment", vague: false}), (:Control {adopted: false, id: "CTRL-DP-10", policy: "DP", text: "Connection of any device to the network, unless specifically authorized by the responsible person.", title: "Connection of any device to the network, unless specifically authorized by the...", vague: false}), (:Control {adopted: false, id: "CTRL-DP-11", policy: "DP", text: "Storage or archival of large amounts of paper materials.", title: "Storage or archival of large amounts of paper materials", vague: false}), (:Control {adopted: false, id: "CTRL-DP-12", policy: "DP", text: "Storage of flammable materials or equipment.", title: "Storage of flammable materials or equipment", vague: true}), (:Control {adopted: false, id: "CTRL-DP-13", policy: "DP", text: "Use of portable heating devices.", title: "Use of portable heating devices", vague: true}), (:Control {adopted: false, id: "CTRL-DP-14", policy: "DP", text: "Smoking, eating, or drinking.", title: "Smoking, eating, or drinking", vague: true}), (:Control {adopted: true, id: "CTRL-DP-15", owners: ["P-ivan-petrov"], policy: "DP", status: "planned", text: "Secure areas must be checked for compliance with security and safety requirements on at least a quarterly basis.", title: "Secure areas must be checked for compliance with security and safety...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-1", policy: "DRP", text: "If the organization’s primary work site is unavailable, an alternate work site shall be used by designated personnel. The organization’s alternate work site is located at [list the address of the alternate work site that the organization will use].", title: "If the organization’s primary work site is unavailable, an alternate work site...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-2", policy: "DRP", text: "The personnel required to report to the alternate work site during a disaster includes [list the personnel titles responsible for reporting to the alternate work site].", title: "The personnel required to report to the alternate work site during a disaster...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-3", policy: "DRP", text: "The following services and technologies are considered to be critical for business operations, and must immediately be restored (in priority order): | [list the critical services and technologies that must remain running during a disaster]", title: "The following services and technologies are considered to be critical for...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-4", policy: "DRP", text: "The following key tasks and SLAs must be considered during a disaster recovery event, in accordance with the organization’s objectives, agreements, and legal, contractual or regulatory obligations: | [list of key tasks / SLAs that must be kept operational, with respective deadlines]", title: "The following key tasks and SLAs must be considered during a disaster recovery...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-5", policy: "DRP", text: "The organization’s Recovery Time Objective (RTO) is [set the maximum amount of time before critical processes must be restored, to include relocation and getting critical services/technologies back online]. Relocation and restoration of critical services and technologies must be completed within this time period.", title: "The organization’s Recovery Time Objective (RTO) is [set the maximum amount of...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-6", policy: "DRP", text: "The following personnel must be notified when this plan is initiated: | [list all personnel (including titles) that must be notified of plan initiation ]", title: "The following personnel must be notified when this plan is initiated", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-7", policy: "DRP", text: "[person responsible for notifications, including title] is responsible for notifying the personnel listed above.", title: "[person responsible for notifications, including title] is responsible for...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-8", policy: "DRP", text: "This plan must only be deactivated by [person or persons with authority to deactivate the plan, including job title].", title: "This plan must only be deactivated by [person or persons with authority to...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-9", policy: "DRP", text: "In order for this plan to be deactivated, all relocation activities and critical service / technology tasks as detailed above must be fully completed and/or restored. If the organization is still operating in an impaired scenario, the plan may still be kept active at the discretion of [person or persons with authority to deactivate the plan, including job title].", title: "In order for this plan to be deactivated, all relocation activities and...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-10", policy: "DRP", text: "The following personnel must be notified when this plan is deactivated: | [list all personnel (including titles) that must be notified of plan activation]", title: "The following personnel must be notified when this plan is deactivated", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-11", policy: "DRP", text: "The organization must endeavor to restore its normal level of business operations as soon as possible.", title: "The organization must endeavor to restore its normal level of business...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-12", policy: "DRP", text: "A list of relevant points of contact both internal and external to the organization is enclosed in Appendix A.", title: "A list of relevant points of contact both internal and external to the...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-13", policy: "DRP", text: "[job title] must take all steps specified in this disaster recovery plan in order to recover the organization’s information technology infrastructure and services.", title: "[job title] must take all steps specified in this disaster recovery plan in...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-14", policy: "DRP", text: "[job title] is authorized to make urgent purchases of equipment and services up to [amount].", title: "[job title] is authorized to make urgent purchases of equipment and services up...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-15", policy: "DRP", text: "[job title] is authorized to communicate with clients.", title: "[job title] is authorized to communicate with clients", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-16", policy: "DRP", text: "[job title] is authorized to communicate with the public.", title: "[job title] is authorized to communicate with the public", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-17", policy: "DRP", text: "[job title] is authorized to communicate with public authorities such as state and local governments and law enforcement.", title: "[job title] is authorized to communicate with public authorities such as state...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-18", policy: "DRP", text: "[job title] is authorized to cooperate with [name of supplier/outsourcing partner].", title: "[job title] is authorized to cooperate with [name of supplier/outsourcing...", vague: false}), (:Control {adopted: false, id: "CTRL-DRP-19", policy: "DRP", text: "[add/modify/remove authorizations in this section as necessary]", title: "[add/modify/remove authorizations in this section as necessary]", vague: true}), (:Control {adopted: false, id: "CTRL-DRP-20", policy: "DRP", text: "Specific recovery steps for information systems infrastructure and services are provided in Appendix B.", title: "Specific recovery steps for information systems infrastructure and services are...", vague: false}), (:Control {adopted: false, id: "CTRL-EP-1", policy: "EP", text: "The cryptographic tools used to protect their information.", title: "The cryptographic tools used to protect their information", vague: false}), (:Control {adopted: false, id: "CTRL-EP-2", policy: "EP", text: "Any capabilities that are available to allow cloud service customers to apply their own cryptographic solutions.", title: "Any capabilities that are available to allow cloud service customers to apply...", vague: false}), (:Control {adopted: false, id: "CTRL-EP-3", policy: "EP", text: "The identity of the countries where the cryptographic tools are used to store or transfer cloud service customers’ data.", title: "The identity of the countries where the cryptographic tools are used to store...", vague: false}), (:Control {adopted: false, id: "CTRL-EP-4", policy: "EP", text: "The use of organizationally-approved encryption must be governed in accordance with the laws of the country, region, or other regulating entity in which users perform their work. Encryption must not be used to violate any laws or regulations including import/export restrictions. The encryption used by the Company conforms to international standards and U.S. import/export requirements, and thus can be used across international boundaries for business purposes.", title: "The use of organizationally-approved encryption must be governed in accordance...", vague: false}), (:Control {adopted: true, id: "CTRL-EP-5", owners: ["P-sofia-lindqvist"], policy: "EP", status: "implemented", text: "The key management service must provide key access to specifically-designated users, with the ability to encrypt/decrypt information and generate data encryption keys.", title: "The key management service must provide key access to specifically-designated...", vague: false}), (:Control {adopted: false, id: "CTRL-EP-6", policy: "EP", text: "The key management service must provide key administration access to specifically-designated users, with the ability to create, schedule delete, enable/disable rotation, and set usage policies for keys.", title: "The key management service must provide key administration access to...", vague: false}), (:Control {adopted: false, id: "CTRL-EP-7", policy: "EP", text: "The key management service must store and backup keys for the entirety of their operational lifetime.", title: "The key management service must store and backup keys for the entirety of their...", vague: false}), (:Control {adopted: true, id: "CTRL-EP-8", owners: ["P-dana-okafor"], policy: "EP", status: "implemented", text: "The key management service must rotate keys at least once every 12 months.", title: "The key management service must rotate keys at least once every 12 months", vague: false}), (:Control {adopted: false, id: "CTRL-ISP-1", policy: "ISP", text: "The organization’s main objectives for information security include the following: | [list the reasons/objectives for maintaining information security at the organization. Examples include a better market image, reduced risk of data breaches and compromises, and compliance with legal, regulatory, and contractual requirements.]", title: "The organization’s main objectives for information security include the...", vague: false}), (:Control {adopted: false, id: "CTRL-ISP-2", policy: "ISP", text: "The organization’s objectives for information security are in line with the organization’s business objectives, strategy, and plans.", title: "The organization’s objectives for information security are in line with the...", vague: false}), (:Control {adopted: false, id: "CTRL-ISP-3", policy: "ISP", text: "Objectives for individual security controls or groups of controls are proposed by the company management team, including but not limited to [list key roles inside the organization that will participate in information security matters], and others as appointed by the CEO; these security controls are approved by the CEO in accordance with the Risk Assessment Policy (Reference (a)).", title: "Objectives for individual security controls or groups of controls are proposed...", vague: true}), (:Control {adopted: false, id: "CTRL-ISP-4", policy: "ISP", text: "All objectives must be reviewed at least once per year.", title: "All objectives must be reviewed at least once per year", vague: false}), (:Control {adopted: false, id: "CTRL-ISP-5", policy: "ISP", text: "The company will measure the fulfillment of all objectives. The measurement will be performed at least once per year. The results must be analyzed, evaluated, and reported to the management team.", title: "The company will measure the fulfillment of all objectives. The measurement...", vague: false}), (:Control {adopted: false, id: "CTRL-ISP-6", policy: "ISP", text: "This policy and the entire information security program must be compliant with legal and regulatory requirements as well as with contractual obligations relevant to the organization.", title: "This policy and the entire information security program must be compliant with...", vague: false}), (:Control {adopted: true, id: "CTRL-ISP-7", owners: ["P-lena-brandt"], policy: "ISP", status: "implemented", text: "All employees, contractors, and other individuals subject to the organization’s information security policy must read and acknowledge all information security policies.", title: "All employees, contractors, and other individuals subject to the organization’s...", vague: false}), (:Control {adopted: false, id: "CTRL-ISP-8", policy: "ISP", text: "The process of selecting information security controls and safeguards for the organization is defined in Reference (a).", title: "The process of selecting information security controls and safeguards for the...", vague: true}), (:Control {adopted: false, id: "CTRL-ISP-9", policy: "ISP", text: "The organization prescribes guidelines for remote workers as part of the Remote Access Policy (reference (b)).", title: "The organization prescribes guidelines for remote workers as part of the Remote...", vague: true}), (:Control {adopted: false, id: "CTRL-ISP-10", policy: "ISP", text: "To counter the risk of unauthorized access, the organization maintains a Data Center Security Policy (reference (c)).", title: "To counter the risk of unauthorized access, the organization maintains a Data...", vague: true}), (:Control {adopted: false, id: "CTRL-ISP-11", policy: "ISP", text: "Security requirements for the software development life cycle, including system development, acquisition and maintenance are defined in the Software Development Lifecycle Policy (reference (d)).", title: "Security requirements for the software development life cycle, including system...", vague: true}), (:Control {adopted: false, id: "CTRL-ISP-12", policy: "ISP", text: "Security requirements for handling information security incidents are defined in the Security Incident Response Policy (reference (e)).", title: "Security requirements for handling information security incidents are defined...", vague: true}), (:Control {adopted: false, id: "CTRL-ISP-13", policy: "ISP", text: "Disaster recovery and business continuity management policy is defined in the Disaster Recovery Policy (reference (f)).", title: "Disaster recovery and business continuity management policy is defined in the...", vague: true}), (:Control {adopted: false, id: "CTRL-ISP-14", policy: "ISP", text: "Requirements for information system availability and redundancy are defined in the System Availability Policy (reference (g)).", title: "Requirements for information system availability and redundancy are defined in...", vague: true}), (:Control {adopted: false, id: "CTRL-LMP-1", policy: "LMP", text: "Activities performed on the system.", title: "Activities performed on the system", vague: true}), (:Control {adopted: false, id: "CTRL-LMP-2", policy: "LMP", text: "The user or entity (i.e. system account) that performed the activity, including the system that the activity was performed from.", title: "The user or entity (i.e. system account) that performed the activity, including...", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-3", policy: "LMP", text: "The file, application, or other object that the activity was performed on.", title: "The file, application, or other object that the activity was performed on", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-4", policy: "LMP", text: "The time that the activity occurred.", title: "The time that the activity occurred", vague: true});
CREATE (:Control {adopted: false, id: "CTRL-LMP-5", policy: "LMP", text: "The tool that the activity was performed with.", title: "The tool that the activity was performed with", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-6", policy: "LMP", text: "The outcome (e.g., success or failure) of the activity.", title: "The outcome (e.g., success or failure) of the activity", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-7", policy: "LMP", text: "Information (including authentication information such as usernames or passwords) is created, read, updated, or deleted.", title: "Information (including authentication information such as usernames or...", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-8", policy: "LMP", text: "Accepted or initiated network connections.", title: "Accepted or initiated network connections", vague: true}), (:Control {adopted: true, id: "CTRL-LMP-9", owners: ["P-omar-haddad"], policy: "LMP", status: "implemented", text: "User authentication and authorization to systems and networks.", title: "User authentication and authorization to systems and networks", vague: false}), (:Control {adopted: true, id: "CTRL-LMP-10", owners: ["P-kenji-aoki"], policy: "LMP", status: "implemented", text: "Granting, modification, or revocation of access rights, including adding a new user or group; changing user privileges, file permissions, database object permissions, firewall rules, and passwords.", title: "Granting, modification, or revocation of access rights, including adding a new...", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-11", policy: "LMP", text: "System, network, or services configuration changes, including software installation, patches, updates, or other installed software changes.", title: "System, network, or services configuration changes, including software...", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-12", policy: "LMP", text: "Startup, shutdown, or restart of an application.", title: "Startup, shutdown, or restart of an application", vague: true}), (:Control {adopted: false, id: "CTRL-LMP-13", policy: "LMP", text: "Application process abort, failure, or abnormal end, especially due to resource exhaustion or reaching a resource limit or threshold (such as CPU, memory, network connections, network bandwidth, disk space, or other resources), the failure of network services such as DHCP or DNS, or hardware fault.", title: "Application process abort, failure, or abnormal end, especially due to resource...", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-14", policy: "LMP", text: "Detection of suspicious and/or malicious activity from a security system such as an Intrusion Detection or Prevention System (IDS/IPS), anti-virus system, or anti-spyware system.", title: "Detection of suspicious and/or malicious activity from a security system such...", vague: false}), (:Control {adopted: true, id: "CTRL-LMP-15", owners: ["P-omar-haddad"], policy: "LMP", status: "implemented", text: "Unless technically impractical or infeasible, all logs must be aggregated in a central system so that activities across different systems can be correlated, analyzed, and tracked for similarities, trends, and cascading effects. Log aggregation systems must have automatic and timely log ingest, event and anomaly tagging and alerting, and ability for manual review.", title: "Unless technically impractical or infeasible, all logs must be aggregated in a...", vague: false}), (:Control {adopted: true, id: "CTRL-LMP-16", owners: ["P-kenji-aoki"], policy: "LMP", status: "partial", text: "The activities of users, administrators and system operators must be reviewed on at least a monthly basis. ii. Logs related to PII must be reviewed on at least a monthly basis in order to identify unusual behavior.", title: "The activities of users, administrators and system operators must be reviewed...", vague: false}), (:Control {adopted: false, id: "CTRL-LMP-17", policy: "LMP", text: "When using an outsourced cloud environment, logs must be kept on cloud environment access and use, resource allocation and utilization, and changes to PII. Logs must be kept for all administrators and operators performing activities in cloud environments.", title: "When using an outsourced cloud environment, logs must be kept on cloud...", vague: false}), (:Control {adopted: true, id: "CTRL-LMP-18", owners: ["P-omar-haddad"], policy: "LMP", status: "implemented", text: "All information systems within the organization must synchronize their clocks by implementing Network Time Protocol (NTP) or a similar capability. All information systems must synchronize with the same primary time source.", title: "All information systems within the organization must synchronize their clocks...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-1", policy: "MCP", text: "All removable media in active use and containing data pertinent to the organization must be registered in the organization’s Asset Inventory (reference (b)).", title: "All removable media in active use and containing data pertinent to the...", vague: true}), (:Control {adopted: false, id: "CTRL-MCP-2", policy: "MCP", text: "All removable media listed in reference (b) must be re-inventoried on a quarterly basis to ensure that it is still within the control of the organization. | To re-inventory an item, the owner of the removable media must check in the item with the organization’s Information Security Manager (ISM). | The ISM must treat any removable media that cannot be located as lost, and a security incident report must be logged in accordance with the Security Incident Response Policy (reference (c)).", title: "All removable media listed in reference (b) must be re-inventoried on a...", vague: true}), (:Control {adopted: false, id: "CTRL-MCP-3", policy: "MCP", text: "The owner of the removable media must conduct all appropriate maintenance on the item at intervals appropriate to the type of media, such as cleaning, formatting, labeling, etc.", title: "The owner of the removable media must conduct all appropriate maintenance on...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-4", policy: "MCP", text: "The owner of the removable media, where practical, must ensure that an alternate or backup copy of the information located on the device exists.", title: "The owner of the removable media, where practical, must ensure that an...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-5", policy: "MCP", text: "Removable media must be stored in a safe place that has a reduced risk of fire or flooding damage.", title: "Removable media must be stored in a safe place that has a reduced risk of fire...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-6", policy: "MCP", text: "If the storage item contains sensitive information, removable media must: | Be stored in a locked cabinet or drawer. | Store only encrypted data that is securely enciphered in accordance with the Encryption Policy (reference (d)).", title: "If the storage item contains sensitive information, removable media must", vague: true}), (:Control {adopted: true, id: "CTRL-MCP-7", owners: ["P-hugo-silva"], policy: "MCP", status: "implemented", text: "All data on removable media devices must be erased, or the device must be destroyed, before it is reused or disposed of.", title: "All data on removable media devices must be erased, or the device must be...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-8", policy: "MCP", text: "When removable media devices are disposed, the device owner must inform the ISM so that it can be removed from reference (b).", title: "When removable media devices are disposed, the device owner must inform the ISM...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-9", policy: "MCP", text: "All cloud storage systems in active use and containing data pertinent to the organization must be registered in reference (b). Registration may be accomplished by manual or automated means.", title: "All cloud storage systems in active use and containing data pertinent to the...", vague: false}), (:Control {adopted: true, id: "CTRL-MCP-10", owners: ["P-amara-osei"], policy: "MCP", status: "planned", text: "All cloud storage systems listed in reference (b) must be re-inventoried on a quarterly basis to ensure that it is still within the control of the organization. To re-inventory an item, the owner of the removable media must check in the item with the organization’s Information Security Manager (ISM). Re-inventory may be accomplished by manual or automated means.", title: "All cloud storage systems listed in reference (b) must be re-inventoried on a...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-11", policy: "MCP", text: "The owner of the cloud storage system must conduct all appropriate maintenance on the system at regular intervals to include system configuration, access control, performance monitoring, etc.", title: "The owner of the cloud storage system must conduct all appropriate maintenance...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-12", policy: "MCP", text: "Data on cloud storage systems must be replicated to at least one other physical location. Depending on the cloud storage provider, this replication may be automatically configured.", title: "Data on cloud storage systems must be replicated to at least one other physical...", vague: false}), (:Control {adopted: true, id: "CTRL-MCP-13", owners: [], policy: "MCP", status: "implemented", text: "The organization must only use cloud storage providers that can demonstrate, either through security accreditation, demonstration, tour, or other means that their facilities are secured, both physically and electronically, using best practices.", title: "The organization must only use cloud storage providers that can demonstrate...", vague: false}), (:Control {adopted: true, id: "CTRL-MCP-14", owners: ["P-sofia-lindqvist"], policy: "MCP", status: "implemented", text: "If the cloud storage system contains sensitive information, that information must be encrypted in accordance with reference (d).", title: "If the cloud storage system contains sensitive information, that information...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-15", policy: "MCP", text: "Data must be erased from from cloud storage systems using a technology and process that is approved by the ISM.", title: "Data must be erased from from cloud storage systems using a technology and...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-16", policy: "MCP", text: "When use of a cloud storage system is discontinued, the system owner must inform the ISM so that it can be removed from reference (b).", title: "When use of a cloud storage system is discontinued, the system owner must...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-17", policy: "MCP", text: "Organizational data that is stored, transferred or processed on personally-owned devices remains under the organization’s ownership, and the organization retains the right to control such data even though it is not the owner of the device.", title: "Organizational data that is stored, transferred or processed on...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-18", policy: "MCP", text: "The ISM is responsible for conducting overall management of personally-owned devices, to include: | Installation and maintenance of Mobile Device Management (MDM) software that can effectively manage, control and wipe data under the organization’s control from personally-owned devices. | Maintain a list of job titles and/or persons authorized to use personally-owned devices for the organization’s business, as well as the applications and databases that may be accessed from such devices. | Maintain a list of applications prohibited from use on personally-owned devices, and ensuring that device users are aware of these restrictions.", title: "The ISM is responsible for conducting overall management of personally-owned...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-19", policy: "MCP", text: "Personally-identifiable information (PII) may not be stored, processed or accessed at any time on a personally-owned device.", title: "Personally-identifiable information (PII) may not be stored, processed or...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-20", policy: "MCP", text: "The following acceptable use requirements must be observed by users of personally-owned devices: | All organizational data must be backed up at regular intervals. | MDM and endpoint protection software must be installed on the device at all times. | Sensitive information stored on the device must be encrypted in accordance with reference (d). | The device must be secured using a password, pin, unlock pattern, fingerprint or equivalent security mechanism. | The device must only connect to secure and encrypted wireless networks. | When using the device outside of the organization’s premises, it must not be left unattended, and if possible, physically secured. | When using the device in public areas, the owner must take measures to ensure that the data cannot be read or accessed by unauthorized persons. | Patches and updates must be installed regularly. | Classified information must be protected in accordance with reference (a). | The device owner must install the ISM before the device is disposed of, sold, or provided to a third party for servicing. | It is prohibited to:", title: "The following acceptable use requirements must be observed by users of...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-21", policy: "MCP", text: "Allow device access for anyone except its owner.", title: "Allow device access for anyone except its owner", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-22", policy: "MCP", text: "Store illegal materials on the device.", title: "Store illegal materials on the device", vague: true}), (:Control {adopted: false, id: "CTRL-MCP-23", policy: "MCP", text: "Install unlicensed software.", title: "Install unlicensed software", vague: true}), (:Control {adopted: false, id: "CTRL-MCP-24", policy: "MCP", text: "Locally-store passwords.", title: "Locally-store passwords", vague: true}), (:Control {adopted: false, id: "CTRL-MCP-25", policy: "MCP", text: "The organization must reserve the right to view, edit, and/or delete any organizational information that is stored, processed or transferred on the device.", title: "The organization must reserve the right to view, edit, and/or delete any...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-26", policy: "MCP", text: "The organization must reserve the right to perform full deletion of all of its data on the device if it considers that necessary for the protection of company-related data, without the consent of the device owner.", title: "The organization must reserve the right to perform full deletion of all of its...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-27", policy: "MCP", text: "The organization will not pay the employees (the owners of BYOD) any fee for using the device for work purposes.", title: "The organization will not pay the employees (the owners of BYOD) any fee for...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-28", policy: "MCP", text: "The organization will pay for any new software that needs to be installed for company use.", title: "The organization will pay for any new software that needs to be installed for...", vague: false}), (:Control {adopted: false, id: "CTRL-MCP-29", policy: "MCP", text: "All security breaches related to personally-owned devices must be reported immediately to the ISM.", title: "All security breaches related to personally-owned devices must be reported...", vague: false}), (:Control {adopted: false, id: "CTRL-OSP-1", policy: "OSP", text: "Management shall ensure: | appropriate entry controls are in place for secure areas | security personnel, identification badges, or electronic key cards should be used to validate employee access to facilities | confirm visitor & guest access procedure has been followed by host staff | management periodically reviews list of individuals with physical access to facilities | card access records and visitor logs are kept for a minimum of 90 days and are periodically reviewed for unusual activity", title: "Management shall ensure", vague: false}), (:Control {adopted: false, id: "CTRL-OSP-2", policy: "OSP", text: "The following policies are applied to all facility access cards/keys: | Access cards/keys shall not be shared or loaned to others | Access cards/keys shall not have identifying information other than a return mail address | Access cards/keys shall be returned to Human Resources when they are no longer needed | Lost or stolen access cards/keys shall be reported immediately | If an employee changes to a role that no longer requires physical access or leaves the company, their access cards/keys will be suspended | Human Resources will regularly review physical security privileges and review access logs", title: "The following policies are applied to all facility access cards/keys", vague: false}), (:Control {adopted: true, id: "CTRL-OSP-3", owners: ["P-ivan-petrov"], policy: "OSP", status: "implemented", text: "Access to physical locations is granted to employees and contractors based on individual job function and will be granted by Human Resources.", title: "Access to physical locations is granted to employees and contractors based on...", vague: false}), (:Control {adopted: true, id: "CTRL-OSP-4", owners: ["P-ivan-petrov"], policy: "OSP", status: "implemented", text: "Any individual granted access to physical spaces will be issued a physical key or access key card. Key and card issuance is tracked by Human Resources and will be periodically reviewed.", title: "Any individual granted access to physical spaces will be issued a physical key...", vague: false}), (:Control {adopted: true, id: "CTRL-OSP-5", owners: ["P-lena-brandt"], policy: "OSP", status: "implemented", text: "In the case of termination, Human Resources should ensure immediate revocation of access (i.e. collection of keys, access cards, and any other asset used to enter facilities) through the offboarding procedure.", title: "In the case of termination, Human Resources should ensure immediate revocation...", vague: false}), (:Control {adopted: false, id: "CTRL-OSP-6", policy: "OSP", text: "The following policies are applied to identification & authorization of visitors and guests: | All visitors must request and receive written onsite authorization from a staff member. | Visitor access shall be tracked with a sign in/out log. The log shall contain:visitor’s name, firm represented, purpose of visit, and onsite personnel authorizing access | The log shall be retained for a minimum of 90 days | Visitors shall be given a badge or other identification that visibly distinguishes visitors from onsite personnel | Visitor badges shall be surrendered before leaving the facility", title: "The following policies are applied to identification & authorization of...", vague: false}), (:Control {adopted: false, id: "CTRL-OSP-7", policy: "OSP", text: "Documented procedures and evidence of practice should be in place for this policy. Acceptable controls and procedures include: | visitor logs | access control procedures | operational key-card access systems | video surveillance systems (with retrievable data) | ledgers if issuing physical keys", title: "Documented procedures and evidence of practice should be in place for this...", vague: false}), (:Control {adopted: false, id: "CTRL-OSP-8", policy: "OSP", text: "Employees, contractors, or third parties found in violation of this policy (whether intentional or accidental) may be subject to disciplinary action, including: | reprimand | loss of access to premises | termination", title: "Employees, contractors, or third parties found in violation of this policy...", vague: false}), (:Control {adopted: false, id: "CTRL-PTP-1", policy: "PTP", text: "Assignment date", title: "Assignment date", vague: true}), (:Control {adopted: false, id: "CTRL-PTP-2", policy: "PTP", text: "Completion date", title: "Completion date", vague: true}), (:Control {adopted: false, id: "CTRL-PTP-3", policy: "PTP", text: "Policy", title: "Policy", vague: true}), (:Control {adopted: false, id: "CTRL-PTP-4", policy: "PTP", text: "Assignee", title: "Assignee", vague: true}), (:Control {adopted: false, id: "CTRL-PTP-5", policy: "PTP", text: "Assigner", title: "Assigner", vague: true}), (:Control {adopted: false, id: "CTRL-PTP-6", policy: "PTP", text: "Notes", title: "Notes", vague: true}), (:Control {adopted: true, id: "CTRL-PWP-1", owners: ["P-dana-okafor"], policy: "PWP", status: "implemented", text: "All system-level passwords should be rotated on at least a quarterly basis. All user-level passwords should be rotated at least every six months.", title: "All system-level passwords should be rotated on at least a quarterly basis. All...", vague: false}), (:Control {adopted: false, id: "CTRL-PWP-2", policy: "PWP", text: "If a credential is suspected of being compromised, the password in question should be rotated immediately and the Engineering/Security team should be notified.", title: "If a credential is suspected of being compromised, the password in question...", vague: false}), (:Control {adopted: false, id: "CTRL-PWP-3", policy: "PWP", text: "All passwords are treated as confidential information and should not be shared with anyone. If you receive a request to share a password, deny the request and contact the system owner for assistance in provisioning an individual user account.", title: "All passwords are treated as confidential information and should not be shared...", vague: false}), (:Control {adopted: true, id: "CTRL-PWP-4", owners: ["P-kenji-aoki"], policy: "PWP", status: "partial", text: "Do not write down passwords, store them in emails, electronic notes, or mobile devices, or share them over the phone. If you must store passwords electronically, do so with a password manager that has been approved by IT. If you truly must share a password, do so through a designated password manager or grant access to an application through a single sign on provider.", title: "Do not write down passwords, store them in emails, electronic notes, or mobile...", vague: false}), (:Control {adopted: false, id: "CTRL-PWP-5", policy: "PWP", text: "Do not use the “Remember Password” feature of applications and web browsers.", title: "Do not use the “Remember Password” feature of applications and web browsers", vague: false}), (:Control {adopted: false, id: "CTRL-PWP-6", policy: "PWP", text: "If you suspect a password has been compromised, rotate the password immediately and notify engineering/security.", title: "If you suspect a password has been compromised, rotate the password immediately...", vague: false}), (:Control {adopted: false, id: "CTRL-PWP-7", policy: "PWP", text: "An employee or contractor found to have violated this policy may be subject to disciplinary action.", title: "An employee or contractor found to have violated this policy may be subject to...", vague: false}), (:Control {adopted: false, id: "CTRL-REAP-1", policy: "REAP", text: "Caution must be exercised when mobile computing equipment is placed or used in uncontrolled spaces such as vehicles, public spaces, hotel rooms, meeting places, conference centers, and other unprotected areas outside the organization’s premises.", title: "Caution must be exercised when mobile computing equipment is placed or used in...", vague: false}), (:Control {adopted: false, id: "CTRL-REAP-2", policy: "REAP", text: "When using remote hosts and mobile computing equipment, users must take care that information on the device (e.g. displayed on the screen) cannot be read by unauthorized persons if the device is being used to connect to the organization’s systems or work with the organization’s data.", title: "When using remote hosts and mobile computing equipment, users must take care...", vague: false}), (:Control {adopted: true, id: "CTRL-REAP-3", owners: ["P-hugo-silva"], policy: "REAP", status: "partial", text: "Remote hosts must be updated and patched for the latest security updates on at least a monthly basis.", title: "Remote hosts must be updated and patched for the latest security updates on at...", vague: false}), (:Control {adopted: true, id: "CTRL-REAP-4", owners: ["P-hugo-silva"], policy: "REAP", status: "implemented", text: "Remote hosts must have endpoint protection software (e.g. malware scanner) installed and updated at all times.", title: "Remote hosts must have endpoint protection software (e.g. malware scanner)...", vague: false}), (:Control {adopted: false, id: "CTRL-REAP-5", policy: "REAP", text: "Persons using mobile computing equipment off-premises are responsible for regular backups of organizational data that resides on the the device.", title: "Persons using mobile computing equipment off-premises are responsible for...", vague: false}), (:Control {adopted: true, id: "CTRL-REAP-6", owners: ["P-dana-okafor"], policy: "REAP", status: "implemented", text: "Access to the organization’s systems must be done through an encrypted and authenticated VPN connection with multi-factor authentication enabled. All users requiring remote access must be provisioned with VPN credentials from the organization’s information technology team. VPN keys must be rotated at least twice per year. Revocation of VPN keys must be included in the Offboarding Policy.", title: "Access to the organization’s systems must be done through an encrypted and...", vague: false}), (:Control {adopted: true, id: "CTRL-REAP-7", owners: ["P-hugo-silva"], policy: "REAP", status: "implemented", text: "Information stored on mobile computing equipment must be encrypted using hard drive full disk encryption.", title: "Information stored on mobile computing equipment must be encrypted using hard...", vague: false}), (:Control {adopted: false, id: "CTRL-REAP-8", policy: "REAP", text: "Employees must be specifically authorized for telework in writing from their hiring manager .", title: "Employees must be specifically authorized for telework in writing from their...", vague: false}), (:Control {adopted: false, id: "CTRL-REAP-9", policy: "REAP", text: "Only device’s assigned owner is permitted to use remote nodes and mobile computing equipment. Unauthorized users (such as others living or working at the location where telework is performed) are not permitted to use such devices.", title: "Only device’s assigned owner is permitted to use remote nodes and mobile...", vague: false}), (:Control {adopted: false, id: "CTRL-REAP-10", policy: "REAP", text: "Devices must be authorized using certificates", title: "Devices must be authorized using certificates", vague: true}), (:Control {adopted: false, id: "CTRL-REAP-11", policy: "REAP", text: "Users performing telework are responsible for the appropriate configuration of the local network used for connecting to the Internet at their telework location.", title: "Users performing telework are responsible for the appropriate configuration of...", vague: false}), (:Control {adopted: false, id: "CTRL-REAP-12", policy: "REAP", text: "Users performing telework must protect the organization’s intellectual property rights, either for software or other materials that are present on remote nodes and mobile computing equipment.", title: "Users performing telework must protect the organization’s intellectual property...", vague: false}), (:Control {adopted: true, id: "CTRL-RIAP-1", owners: ["P-maya-chen"], policy: "RIAP", status: "implemented", text: "The risk assessment process includes the identification of threats and vulnerabilities having to do with company assets.", title: "The risk assessment process includes the identification of threats and...", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-2", policy: "RIAP", text: "The first step in the risk assessment is to identify all assets within the scope of the information security program; in other words, all assets which may affect the confidentiality, integrity, and/or availability of information in the organization. Assets may include documents in paper or electronic form, applications, databases, information technology equipment, infrastructure, and external/outsourced services and processes. For each asset, an owner must be identified.", title: "The first step in the risk assessment is to identify all assets within the...", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-3", policy: "RIAP", text: "The next step is to identify all threats and vulnerabilities associated with each asset. Threats and vulnerabilities must be listed in a risk assessment table. Each asset may be associated with multiple threats, and each threat may be associated with multiple vulnerabilities. A sample risk assessment table is provided as part of the Risk Assessment Report Template (reference (a)).", title: "The next step is to identify all threats and vulnerabilities associated with...", vague: true}), (:Control {adopted: false, id: "CTRL-RIAP-4", policy: "RIAP", text: "For each risk, an owner must be identified. The risk owner and the asset owner may be the same individual.", title: "For each risk, an owner must be identified. The risk owner and the asset owner...", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-5", policy: "RIAP", text: "Once risk owners are identified, they must assess: | Consequences for each combination of threats and vulnerabilities for an individual asset if such a risk materializes. | Likelihood of occurrence of such a risk (i.e. the probability that a threat will exploit the vulnerability of the respective asset). | Criteria for determining consequence and likelihood are defined in Tables 3 and 4.", title: "Once risk owners are identified, they must assess", vague: true}), (:Control {adopted: false, id: "CTRL-RIAP-6", policy: "RIAP", text: "The risk level is calculated by adding the consequence score and the likelihood score. +-----------------+-----------------+--------------------------------------------------------------+ | Consequence | Consequence | Description | | Level | Score | | +=================+=================+==============================================================+ | Low | 0 | Loss of confidentiality, integrity, or availability will not | | | | affect the organization's cash flow, legal, or contractual | | | | obligations, or reputation. | +-----------------+-----------------+--------------------------------------------------------------+ | | | | +-----------------+-----------------+--------------------------------------------------------------+ | Moderate | 1 | Loss of confidentiality, integrity, or availability may incur| | | | financial cost and has low or moderate impact on the | | | | organization's legal or contractual obligations and/or | | | | reputation. | +-----------------+-----------------+--------------------------------------------------------------+ | | | | +-----------------+-----------------+--------------------------------------------------------------+ | High | 2 | Loss of confidentiality, integrity, or availability will have| | | | immediate and or/considerable impact on the organization's | | | | cash flow, operations, legal and contractual obligations,and/| | | | or reputation. | +-----------------+-----------------+--------------------------------------------------------------+ | | | | +-----------------+-----------------+--------------------------------------------------------------+ Table 3: Description of Consequence Levels and Criteria +-----------------+-----------------+--------------------------------------------------------------+ | Likelihood | Likelihood | Description | | Level | Score | | +=================+=================+==============================================================+ | Low | 0 | Either existing security controls are strong and have so far | | | | provided an adequate level of protection, or the probability | | | | of the risk being realized is extremely low. No new incidents| | | | are expected in the future. | +-----------------+-----------------+--------------------------------------------------------------+ | | | | +-----------------+-----------------+--------------------------------------------------------------+ | Moderate | 1 | Either existing security controls have most provided an | | | | adequate level of protection or the probability of the risk | | | | being realized is moderate. Some minor incidents may have | | | | occured. New incidents are possible, but not highly likely. | +-----------------+-----------------+--------------------------------------------------------------+ | | | | +-----------------+-----------------+--------------------------------------------------------------+ | High | 2 | Either existing security controls are not in place or | | | | ineffective; there is a high probability of the risk being | | | | realized. Incidents have a high likelihood of occuring in the| | | | future. | +-----------------+-----------------+--------------------------------------------------------------+ | | | | +-----------------+-----------------+--------------------------------------------------------------+ Table 4: Description of Likelihood Levels and Criteria &nbsp; b. Risk Acceptance Criteria", title: "The risk level is calculated by adding the consequence score and the likelihood...", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-7", policy: "RIAP", text: "Risk values 0 through 2 are considered to be acceptable risks.", title: "Risk values 0 through 2 are considered to be acceptable risks", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-8", policy: "RIAP", text: "Risk values 3 and 4 are considered to be unacceptable risks. Unacceptable risks must be treated. c. Risk Treatment", title: "Risk values 3 and 4 are considered to be unacceptable risks. Unacceptable risks...", vague: false}), (:Control {adopted: true, id: "CTRL-RIAP-9", owners: ["P-maya-chen"], policy: "RIAP", status: "implemented", text: "Risk treatment is implemented through the Risk Treatment Table. All risks from the Risk Assessment Table must be copied to the Risk Treatment Table for disposition, along with treatment options and residual risk. A sample Risk Treatment Table is provided in reference (a).", title: "Risk treatment is implemented through the Risk Treatment Table. All risks from...", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-10", policy: "RIAP", text: "As part of this risk treatment process, the CEO and/or other company managers shall determine objectives for mitigating or treating risks. All unacceptable risks must be treated. For continuous improvement purposes, company managers may also opt to treat other risks for company assets, even if their risk score is deemed to be acceptable.", title: "As part of this risk treatment process, the CEO and/or other company managers...", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-11", policy: "RIAP", text: "Treatment options for risks include the following options: | Selection or development of security control(s). | Transferring the risks to a third party; for example, by purchasing an insurance policy or signing a contract with suppliers or partners. | Avoiding the risk by discontinuing the business activity that causes such risk. | Accepting the risk; this option is permitted only if the selection of other risk treatment options would cost more than the potential impact of the risk being realized.", title: "Treatment options for risks include the following options", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-12", policy: "RIAP", text: "After selecting a treatment option, the risk owner should estimate the new consequence and likelihood values after the planned controls are implemented.", title: "After selecting a treatment option, the risk owner should estimate the new...", vague: false}), (:Control {adopted: true, id: "CTRL-RIAP-13", owners: ["P-maya-chen"], policy: "RIAP", status: "planned", text: "The Risk Assessment Table and Risk Treatment Table must be updated when newly identified risks are identified. At a minimum, this update and review shall be conducted once per year. It is highly recommended that the Risk Assessment and Risk Treatment Table be updated when significant changes occur to the organization, technology, business objectives, or business environment.", title: "The Risk Assessment Table and Risk Treatment Table must be updated when newly...", vague: false}), (:Control {adopted: false, id: "CTRL-RIAP-14", policy: "RIAP", text: "The results of risk assessment and risk treatment, and all subsequent reviews, shall be documented in a Risk Assessment Report.", title: "The results of risk assessment and risk treatment, and all subsequent reviews...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-1", policy: "RP", text: "Retention is defined as the maintenance of information in a production or live environment which can be accessed by an authorized user in the ordinary course of business.", title: "Retention is defined as the maintenance of information in a production or live...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-2", policy: "RP", text: "Information used in the development, staging, and testing of systems shall not be retained beyond their active use period nor copied into production or live environments.", title: "Information used in the development, staging, and testing of systems shall not...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-3", policy: "RP", text: "By default, the retention period of information shall be an active use period of exactly two years from its creation unless an exception is obtained permitting a longer or shorter retention period. The business unit responsible for the information must request the exception.", title: "By default, the retention period of information shall be an active use period...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-4", policy: "RP", text: "After the active use period of information is over in accordance with this policy and approved exceptions, information must be archived for a defined period. Once the defined archive period is over, the information must be destroyed.", title: "After the active use period of information is over in accordance with this...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-5", policy: "RP", text: "Each business unit is responsible for the information it creates, uses, stores, processes and destroys, according to the requirements of this policy. The responsible business unit is considered to be the information owner.", title: "Each business unit is responsible for the information it creates, uses, stores...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-6", policy: "RP", text: "The organization’s legal counsel may issue a litigation hold to request that information relating to potential or actual litigation, arbitration or other claims, demands, disputes or regulatory action be retained in accordance with instructions from the legal counsel.", title: "The organization’s legal counsel may issue a litigation hold to request that...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-7", policy: "RP", text: "Each employee and contractor affiliated with the company must return information in their possession or control to the organization upon separation and/or retirement.", title: "Each employee and contractor affiliated with the company must return...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-8", policy: "RP", text: "Information owners must enforce the retention, archiving and destruction of information, and communicate these periods to relevant parties.", title: "Information owners must enforce the retention, archiving and destruction of...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-9", policy: "RP", text: "Archiving is defined as secured storage of information such that the information is rendered inaccessible by authorized users in the ordinary course of business but can be retrieved by an administrator designated by company management. | Physical (e.g., paper) records must be archived in secured storage (onsite or offsite) and clearly labeled in archive boxes naming the information owner. | Electronic records must be archived with strict access controls set by the information owner and appropriate to secure the confidentiality, integrity and accessibility of the information.", title: "Archiving is defined as secured storage of information such that the...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-10", policy: "RP", text: "The default archiving period of information shall be 7 years unless an approved exception permits a longer or shorter period. Exceptions must be requested by the information owner. | As a guideline, an archiving period of more than 7 years may be granted for information with a vital historical purpose such as corporate records, contracts, and technical/trade secrets. | As a guideline, an archiving period of less than 7 years may be granted for information with a limited business purpose such as email, travel itineraries, pre-trip advisories, or to comply with specific legal, contractual and/or regulatory requirements (e.g., PCI DSS, GDPR, etc.)", title: "The default archiving period of information shall be 7 years unless an approved...", vague: false});
CREATE (:Control {adopted: false, id: "CTRL-RP-11", policy: "RP", text: "Information must be destroyed (defined below) at the end of the elapsed archiving period.", title: "Information must be destroyed (defined below) at the end of the elapsed...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-12", policy: "RP", text: "Destruction is defined as the physical or technical destruction sufficient to render the information contained in the document irretrievable by ordinary commercially-available means.", title: "Destruction is defined as the physical or technical destruction sufficient to...", vague: false}), (:Control {adopted: true, id: "CTRL-RP-13", owners: ["P-amara-osei"], policy: "RP", status: "partial", text: "The organization must maintain and enforce a detailed list of approved destruction methods appropriate for each type of information archived, whether in physical storage media such as CD-ROMs, DVDs, backup tapes, hard drives, mobile devices, portable drives or in database records or backup files. Physical information in paper form must be shredded using an authorized shredding device; waste must be periodically removed by approved personnel.", title: "The organization must maintain and enforce a detailed list of approved...", vague: false}), (:Control {adopted: false, id: "CTRL-RP-14", policy: "RP", text: "Retention and archival periods for information that is created, processed, stored and used by the organization is defined in Appendix A, “Retention Periods.”", title: "Retention and archival periods for information that is created, processed...", vague: true}), (:Control {adopted: true, id: "CTRL-SCP-1", owners: ["P-nia-walker"], policy: "SCP", status: "implemented", text: "Any changes to the security architecture or customer data handling of a system must be formally requested in writing to the organization’s Information Security Manager (ISM), and approved by the ISM and the Chief Information Officer (CIO).", title: "Any changes to the security architecture or customer data handling of a system...", vague: false}), (:Control {adopted: false, id: "CTRL-SCP-2", policy: "SCP", text: "All change requests must be documented.", title: "All change requests must be documented", vague: true}), (:Control {adopted: false, id: "CTRL-SCP-3", policy: "SCP", text: "All change requests must be prioritized in terms of benefits, urgency, effort required, and potential impacts to the organization’s operations.", title: "All change requests must be prioritized in terms of benefits, urgency, effort...", vague: false}), (:Control {adopted: false, id: "CTRL-SCP-4", policy: "SCP", text: "All implemented changes must be communicated to relevant users.", title: "All implemented changes must be communicated to relevant users", vague: false}), (:Control {adopted: false, id: "CTRL-SCP-5", policy: "SCP", text: "Planning: plan the change, including the implementation design, scheduling, and implementation of a communications plan, testing plan, and roll-back plan.", title: "Planning: plan the change, including the implementation design, scheduling, and...", vague: false}), (:Control {adopted: false, id: "CTRL-SCP-6", policy: "SCP", text: "Evaluation: evaluate the change, including priority level of the service and risk that the proposed change introduces to the system; determine the change type and the specific step-by-step process to implement the change.", title: "Evaluation: evaluate the change, including priority level of the service and...", vague: false}), (:Control {adopted: false, id: "CTRL-SCP-7", policy: "SCP", text: "Review: review the change plan amongst the CIO, ISM, Engineering Lead, and, if applicable, Business Unit Manager.", title: "Review: review the change plan amongst the CIO, ISM, Engineering Lead, and, if...", vague: false}), (:Control {adopted: true, id: "CTRL-SCP-8", owners: ["P-nia-walker"], policy: "SCP", status: "partial", text: "Approval: the CIO must approve the change plan.", title: "Approval: the CIO must approve the change plan", vague: false}), (:Control {adopted: false, id: "CTRL-SCP-9", policy: "SCP", text: "Communication: communicate the change to all users of the system.", title: "Communication: communicate the change to all users of the system", vague: false}), (:Control {adopted: false, id: "CTRL-SCP-10", policy: "SCP", text: "Implementation: test and implement the change.", title: "Implementation: test and implement the change", vague: true}), (:Control {adopted: false, id: "CTRL-SCP-11", policy: "SCP", text: "Documentation: record the change and any post-implementation issues.", title: "Documentation: record the change and any post-implementation issues", vague: false}), (:Control {adopted: true, id: "CTRL-SCP-12", owners: ["P-nia-walker"], policy: "SCP", status: "planned", text: "Post-change review: conduct a post-implementation review to determine how the change is impacting the organization, either positively or negatively. Discuss and document any lessons learned.", title: "Post-change review: conduct a post-implementation review to determine how the...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-1", policy: "SDLCP", text: "Requirements Analysis", title: "Requirements Analysis", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-2", policy: "SDLCP", text: "Architecture and Design", title: "Architecture and Design", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-3", policy: "SDLCP", text: "Testing", title: "Testing", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-4", policy: "SDLCP", text: "Deployment/Implementation", title: "Deployment/Implementation", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-5", policy: "SDLCP", text: "Operations/Maintenance", title: "Operations/Maintenance", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-6", policy: "SDLCP", text: "Decommission", title: "Decommission", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-7", policy: "SDLCP", text: "During all phases of the SDLC where a system is not in production, the system must not have live data sets that contain information identifying actual people or corporate entities, actual financial data such as account numbers, security codes, routing information, or any other financially identifying data. Information that would be considered sensitive must never be used outside of production environments.", title: "During all phases of the SDLC where a system is not in production, the system...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-8", policy: "SDLCP", text: "Analyze business requirements.", title: "Analyze business requirements", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-9", policy: "SDLCP", text: "Perform a risk assessment. More information on risk assessments is discussed in the Risk Assessment Policy (reference (a)).", title: "Perform a risk assessment. More information on risk assessments is discussed in...", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-10", policy: "SDLCP", text: "Discuss aspects of security (e.g., confidentiality, integrity, availability) and how they might apply to this requirement.", title: "Discuss aspects of security (e.g., confidentiality, integrity, availability)...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-11", policy: "SDLCP", text: "Review regulatory requirements and the organization’s policies, standards, procedures and guidelines.", title: "Review regulatory requirements and the organization’s policies, standards...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-12", policy: "SDLCP", text: "Review future business goals.", title: "Review future business goals", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-13", policy: "SDLCP", text: "Review current business and information technology operations.", title: "Review current business and information technology operations", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-14", policy: "SDLCP", text: "Incorporate program management items, including: | Analysis of current system users/customers. | Understand customer-partner interface requirements (e.g., business-level, network). | Discuss project timeframe.", title: "Incorporate program management items, including", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-15", policy: "SDLCP", text: "Develop and prioritize security solution requirements.", title: "Develop and prioritize security solution requirements", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-16", policy: "SDLCP", text: "Assess cost and budget constraints for security solutions, including development and operations.", title: "Assess cost and budget constraints for security solutions, including...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-17", policy: "SDLCP", text: "Approve security requirements and budget.", title: "Approve security requirements and budget", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-18", policy: "SDLCP", text: "Make “buy vs. build” decisions for security services based on the information above.", title: "Make “buy vs. build” decisions for security services based on the information...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-19", policy: "SDLCP", text: "Educate development teams on how to create a secure system.", title: "Educate development teams on how to create a secure system", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-20", policy: "SDLCP", text: "Develop and/or refine infrastructure security architecture.", title: "Develop and/or refine infrastructure security architecture", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-21", policy: "SDLCP", text: "List technical and non-technical security controls.", title: "List technical and non-technical security controls", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-22", policy: "SDLCP", text: "Perform architecture walkthrough.", title: "Perform architecture walkthrough", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-23", policy: "SDLCP", text: "Create a system-level security design.", title: "Create a system-level security design", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-24", policy: "SDLCP", text: "Create high-level non-technical and integrated technical security designs.", title: "Create high-level non-technical and integrated technical security designs", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-25", policy: "SDLCP", text: "Perform a cost/benefit analysis for design components.", title: "Perform a cost/benefit analysis for design components", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-26", policy: "SDLCP", text: "Document the detailed technical security design.", title: "Document the detailed technical security design", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-27", policy: "SDLCP", text: "Perform a design review, which must include, at a minimum, technical reviews of application and infrastructure, as well as a review of high-level processes.", title: "Perform a design review, which must include, at a minimum, technical reviews of...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-28", policy: "SDLCP", text: "Describe detailed security processes and procedures, including: segregation of duties and segregation of development, testing and production environments.", title: "Describe detailed security processes and procedures, including: segregation of...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-29", policy: "SDLCP", text: "Design initial end-user training and awareness programs.", title: "Design initial end-user training and awareness programs", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-30", policy: "SDLCP", text: "Design a general security test plan.", title: "Design a general security test plan", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-31", policy: "SDLCP", text: "Update the organization’s policies, standards, and procedures, if appropriate.", title: "Update the organization’s policies, standards, and procedures, if appropriate", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-32", policy: "SDLCP", text: "Assess and document how to mitigate residual application and infrastructure vulnerabilities.", title: "Assess and document how to mitigate residual application and infrastructure...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-33", policy: "SDLCP", text: "Design and establish separate development and test environments.", title: "Design and establish separate development and test environments", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-34", policy: "SDLCP", text: "Set up a secure development environment (e.g., servers, storage).", title: "Set up a secure development environment (e.g., servers, storage)", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-35", policy: "SDLCP", text: "Train infrastructure teams on installation and configuration of applicable software, if required.", title: "Train infrastructure teams on installation and configuration of applicable...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-36", policy: "SDLCP", text: "Develop code for application-level security components.", title: "Develop code for application-level security components", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-37", policy: "SDLCP", text: "Install, configure and integrate the test infrastructure.", title: "Install, configure and integrate the test infrastructure", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-38", policy: "SDLCP", text: "Set up security-related vulnerability tracking processes.", title: "Set up security-related vulnerability tracking processes", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-39", policy: "SDLCP", text: "Develop a detailed security test plan for current and future versions (i.e., regression testing).", title: "Develop a detailed security test plan for current and future versions (i.e...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-40", policy: "SDLCP", text: "Conduct unit testing and integration testing.", title: "Conduct unit testing and integration testing", vague: true}), (:Control {adopted: true, id: "CTRL-SDLCP-41", owners: ["P-tomas-ferreira"], policy: "SDLCP", status: "implemented", text: "Perform a code and configuration review through both static and dynamic analysis of code to identify vulnerabilities.", title: "Perform a code and configuration review through both static and dynamic...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-42", policy: "SDLCP", text: "Test configuration procedures.", title: "Test configuration procedures", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-43", policy: "SDLCP", text: "Perform system tests.", title: "Perform system tests", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-44", policy: "SDLCP", text: "Conduct performance and load tests with security controls enabled.", title: "Conduct performance and load tests with security controls enabled", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-45", policy: "SDLCP", text: "Perform usability testing of application security controls.", title: "Perform usability testing of application security controls", vague: true}), (:Control {adopted: true, id: "CTRL-SDLCP-46", owners: ["P-kenji-aoki"], policy: "SDLCP", status: "implemented", text: "Conduct independent vulnerability assessments of the system, including the infrastructure and application.", title: "Conduct independent vulnerability assessments of the system, including the...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-47", policy: "SDLCP", text: "Conduct pilot deployment of the infrastructure, application and other relevant components.", title: "Conduct pilot deployment of the infrastructure, application and other relevant...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-48", policy: "SDLCP", text: "Conduct transition between pilot and full-scale deployment.", title: "Conduct transition between pilot and full-scale deployment", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-49", policy: "SDLCP", text: "Perform integrity checking on system files to ensure authenticity.", title: "Perform integrity checking on system files to ensure authenticity", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-50", policy: "SDLCP", text: "Deploy training and awareness programs to train administrative personnel and users in the system’s security functions.", title: "Deploy training and awareness programs to train administrative personnel and...", vague: false}), (:Control {adopted: true, id: "CTRL-SDLCP-51", owners: ["P-tomas-ferreira"], policy: "SDLCP", status: "implemented", text: "Require participation of at least two developers in order to conduct full-scale deployment to the production environment.", title: "Require participation of at least two developers in order to conduct full-scale...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-52", policy: "SDLCP", text: "Several security tasks and activities must be routinely performed to operate and administer the system, including but not limited to: | Administering users and access. | Tuning performance. | Performing backups according to requirements defined in the System Availability Policy | Performing system maintenance (i.e., testing and applying security updates and patches). | Conducting training and awareness. | Conducting periodic system vulnerability assessments. | Conducting annual risk assessments.", title: "Several security tasks and activities must be routinely performed to operate...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-53", policy: "SDLCP", text: "Operational systems must: | Be reviewed to ensure that the security controls, both automated and manual, are functioning correctly and effectively. | Have logs that are periodically reviewed to evaluate the security of the system and validate audit controls. | Implement ongoing monitoring of systems and users to ensure detection of security violations and unauthorized changes. | Validate the effectiveness of the implemented security controls through security training as required by the Procedure For Executing Incident Response. | Have a software application and/or hardware patching process that is performed regularly in order to eliminate software bug and security problems being introduced into the organization’s technology environment. Patches and updates must be applied within ninety (90) days of release to provide for adequate testing and propagation of software updates. Emergency, critical, break-fix, and zero-day vulnerability patch releases must be applied as quickly as possible.", title: "Operational systems must", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-54", policy: "SDLCP", text: "Conduct unit testing and integration testing on the system after component removal.", title: "Conduct unit testing and integration testing on the system after component...", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-55", policy: "SDLCP", text: "Conduct operational transition for component removal/replacement.", title: "Conduct operational transition for component removal/replacement", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-56", policy: "SDLCP", text: "Determine data retention requirements for application software and systems data.", title: "Determine data retention requirements for application software and systems data", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-57", policy: "SDLCP", text: "Document the detailed technical security design.", title: "Document the detailed technical security design", vague: true}), (:Control {adopted: false, id: "CTRL-SDLCP-58", policy: "SDLCP", text: "Update the organization’s policies, standards and procedures, if appropriate.", title: "Update the organization’s policies, standards and procedures, if appropriate", vague: false}), (:Control {adopted: false, id: "CTRL-SDLCP-59", policy: "SDLCP", text: "Assess and document how to mitigate residual application and infrastructure vulnerabilities.", title: "Assess and document how to mitigate residual application and infrastructure...", vague: false}), (:Control {adopted: true, id: "CTRL-SIRP-1", owners: ["P-maya-chen"], policy: "SIRP", status: "implemented", text: "All users must report any system vulnerability , incident, or event pointing to a possible incident to the Information Security Manager (ISM) as quickly as possible but no later than 24 hours. Incidents must be reported by sending an email message to <insert email address here> with details of the incident.", title: "All users must report any system vulnerability , incident, or event pointing to...", vague: false}), (:Control {adopted: true, id: "CTRL-SIRP-2", owners: ["P-maya-chen"], policy: "SIRP", status: "implemented", text: "Users must be trained on the procedures for reporting information security incidents or discovered vulnerabilities, and their responsibilities to report such incidents. Failure to report information security incidents shall be considered to be a security violation and will be reported to the Human Resources (HR) Manager for disciplinary action.", title: "Users must be trained on the procedures for reporting information security...", vague: false}), (:Control {adopted: true, id: "CTRL-SIRP-3", owners: ["P-kenji-aoki"], policy: "SIRP", status: "partial", text: "Information and artifacts associated with security incidents (including but not limited to files, logs, and screen captures) must be preserved in the event that they need to be used as evidence of a crime.", title: "Information and artifacts associated with security incidents (including but not...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-4", policy: "SIRP", text: "All information security incidents must be responded to through the incident management procedures defined below.", title: "All information security incidents must be responded to through the incident...", vague: false}), (:Control {adopted: true, id: "CTRL-SIRP-5", owners: ["P-maya-chen"], policy: "SIRP", status: "implemented", text: "In order to appropriately plan and prepare for incidents, the organization must review incident response procedures at least once per year for currency, and update as required.", title: "In order to appropriately plan and prepare for incidents, the organization must...", vague: false}), (:Control {adopted: true, id: "CTRL-SIRP-6", owners: ["P-maya-chen"], policy: "SIRP", status: "partial", text: "The incident response procedure must be tested on at least twice per year", title: "The incident response procedure must be tested on at least twice per year", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-7", policy: "SIRP", text: "The incident response logs must be reviewed once per month to assess response effectiveness.", title: "The incident response logs must be reviewed once per month to assess response...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-8", policy: "SIRP", text: "Define on-call schedule and assign an Information Security Manager (ISM) responsible for managing incident response procedure during each availability window.", title: "Define on-call schedule and assign an Information Security Manager (ISM)...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-9", policy: "SIRP", text: "Define notification channel to alert the on-call ISM of a potential security incident. Establish company resource that includes up to date contact information for on-call ISM.", title: "Define notification channel to alert the on-call ISM of a potential security...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-10", policy: "SIRP", text: "Assign management sponsors from the Engineering, Legal, HR, Marketing, and C-Suite teams.", title: "Assign management sponsors from the Engineering, Legal, HR, Marketing, and...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-11", policy: "SIRP", text: "Distribute Procedure For Execute Incident Response to all staff and ensure up-to-date versions are accessible in a dedicated company resource.", title: "Distribute Procedure For Execute Incident Response to all staff and ensure...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-12", policy: "SIRP", text: "Require all staff to complete training for Procedure For Executing Incident Response at least twice per year.", title: "Require all staff to complete training for Procedure For Executing Incident...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-13", policy: "SIRP", text: "Description of the incident", title: "Description of the incident", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-14", policy: "SIRP", text: "Date, time, and location of the incident", title: "Date, time, and location of the incident", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-15", policy: "SIRP", text: "Person who discovered the incident", title: "Person who discovered the incident", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-16", policy: "SIRP", text: "How the incident was discovered", title: "How the incident was discovered", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-17", policy: "SIRP", text: "Known evidence of the incident", title: "Known evidence of the incident", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-18", policy: "SIRP", text: "Affected system(s)", title: "Affected system(s)", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-19", policy: "SIRP", text: "High: the incident is potentially catastrophic to the organization and/or disrupts the organization’s day-to-day operations; a violation of legal, regulatory or contractual requirements is likely.", title: "High: the incident is potentially catastrophic to the organization and/or...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-20", policy: "SIRP", text: "Medium: the incident will cause harm to one or more business units within the organization and/or will cause delays to a business unit’s activities.", title: "Medium: the incident will cause harm to one or more business units within the...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-21", policy: "SIRP", text: "Low: the incident is a clear violation of organizational security policy, but will not substantively impact the business.", title: "Low: the incident is a clear violation of organizational security policy, but...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-22", policy: "SIRP", text: "The ISM, in consultation with management sponsors, shall determine appropriate incident response activities in order to contain and resolve incidents.", title: "The ISM, in consultation with management sponsors, shall determine appropriate...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-23", policy: "SIRP", text: "The ISM must take all necessary steps to preserve forensic evidence (e.g. log information, files, images) for further investigation to determine if any malicious activity has taken place. All such information must be preserved and provided to law enforcement if the incident is determined to be malicious.", title: "The ISM must take all necessary steps to preserve forensic evidence (e.g. log...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-24", policy: "SIRP", text: "If the incident is deemed as High or Medium, the ISM must work with the VP Brand/Creative, General Counsel, and HR Manager to create and execute a communications plan that communicates the incident to users, the public, and others affected.", title: "If the incident is deemed as High or Medium, the ISM must work with the VP...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-25", policy: "SIRP", text: "Description of the incident", title: "Description of the incident", vague: true});
CREATE (:Control {adopted: false, id: "CTRL-SIRP-26", policy: "SIRP", text: "Incident severity level", title: "Incident severity level", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-27", policy: "SIRP", text: "Root cause (e.g. source address, website malware, vulnerability)", title: "Root cause (e.g. source address, website malware, vulnerability)", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-28", policy: "SIRP", text: "Evidence", title: "Evidence", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-29", policy: "SIRP", text: "Mitigations applied (e.g. patch, re-image)", title: "Mitigations applied (e.g. patch, re-image)", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-30", policy: "SIRP", text: "Status (open, closed, archived)", title: "Status (open, closed, archived)", vague: true}), (:Control {adopted: false, id: "CTRL-SIRP-31", policy: "SIRP", text: "Disclosures (parties to which the details of this incident were disclosed to, such as customers, vendors, law enforcement, etc.)", title: "Disclosures (parties to which the details of this incident were disclosed to...", vague: false}), (:Control {adopted: true, id: "CTRL-SIRP-32", owners: ["P-kenji-aoki"], policy: "SIRP", status: "implemented", text: "After an incident has been resolved, the ISM must conduct a post mortem that includes root cause analysis and documentation any lessons learned.", title: "After an incident has been resolved, the ISM must conduct a post mortem that...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-33", policy: "SIRP", text: "Depending on the severity of the incident, the Chief Executive Officer (CEO) may elect to contact external authorities, including but not limited to law enforcement, private investigation firms, and government organizations as part of the response to the incident.", title: "Depending on the severity of the incident, the Chief Executive Officer (CEO)...", vague: false}), (:Control {adopted: false, id: "CTRL-SIRP-34", policy: "SIRP", text: "The ISM must notify all users of the incident, conduct additional training if necessary, and present any lessons learned to prevent future occurrences. Where necessary, the HR Manager must take disciplinary action if a user’s activity is deemed as malicious.", title: "The ISM must notify all users of the incident, conduct additional training if...", vague: false}), (:Control {adopted: true, id: "CTRL-VMP-1", owners: ["P-ruth-abara"], policy: "VMP", status: "implemented", text: "IT vendors are prohibited from accessing the organization’s information security assets until a contract containing security controls is agreed to and signed by the appropriate parties.", title: "IT vendors are prohibited from accessing the organization’s information...", vague: false}), (:Control {adopted: false, id: "CTRL-VMP-2", policy: "VMP", text: "All IT vendors must comply with the security policies defined and derived from the Information Security Policy (reference (a)).", title: "All IT vendors must comply with the security policies defined and derived from...", vague: true}), (:Control {adopted: false, id: "CTRL-VMP-3", policy: "VMP", text: "All security incidents by IT vendors or partners must be documented in accordance with the organization’s Security Incident Response Policy (reference (b)) and immediately forwarded to the Information Security Manager (ISM).", title: "All security incidents by IT vendors or partners must be documented in...", vague: true}), (:Control {adopted: false, id: "CTRL-VMP-4", policy: "VMP", text: "The organization must adhere to the terms of all Service Level Agreements (SLAs) entered into with IT vendors. As terms are updated, and as new ones are entered into, the organization must implement any changes or controls needed to ensure it remains in compliance.", title: "The organization must adhere to the terms of all Service Level Agreements...", vague: false}), (:Control {adopted: true, id: "CTRL-VMP-5", owners: ["P-maya-chen"], policy: "VMP", status: "planned", text: "Security risks related to IT vendors and partners must be identified during the risk assessment process.", title: "Security risks related to IT vendors and partners must be identified during the...", vague: false}), (:Control {adopted: false, id: "CTRL-VMP-6", policy: "VMP", text: "The risk assessment must identify risks related to information and communication technology, as well as risks related to IT vendor supply chains, to include sub-suppliers.", title: "The risk assessment must identify risks related to information and...", vague: false}), (:Control {adopted: false, id: "CTRL-VMP-7", policy: "VMP", text: "IT vendors and partners must ensure that organizational records are protected, safeguarded, and disposed of securely. The organization strictly adheres to all applicable legal, regulatory and contractual requirements regarding the collection, processing, and transmission of sensitive data such as Personally-Identifiable Information (PII).", title: "IT vendors and partners must ensure that organizational records are protected...", vague: false}), (:Control {adopted: false, id: "CTRL-VMP-8", policy: "VMP", text: "The organization may choose to audit IT vendors and partners to ensure compliance with applicable security policies, as well as legal, regulatory and contractual obligations.", title: "The organization may choose to audit IT vendors and partners to ensure...", vague: false}), (:Control {adopted: true, id: "CTRL-WP-1", owners: ["P-hugo-silva"], policy: "WP", status: "partial", text: "Operating system must be no more than one generation older than current", title: "Operating system must be no more than one generation older than current", vague: false}), (:Control {adopted: false, id: "CTRL-WP-2", policy: "WP", text: "Device must be encrypted at rest", title: "Device must be encrypted at rest", vague: true}), (:Control {adopted: true, id: "CTRL-WP-3", owners: ["P-hugo-silva"], policy: "WP", status: "implemented", text: "Device must be locked when not in use or when employee leaves the workstation", title: "Device must be locked when not in use or when employee leaves the workstation", vague: false}), (:Control {adopted: false, id: "CTRL-WP-4", policy: "WP", text: "Workstations must be used for authorized business purposes only", title: "Workstations must be used for authorized business purposes only", vague: false}), (:Control {adopted: false, id: "CTRL-WP-5", policy: "WP", text: "Loss or destruction of devices should be reported immediately", title: "Loss or destruction of devices should be reported immediately", vague: false}), (:Control {adopted: true, id: "CTRL-WP-6", owners: ["P-hugo-silva"], policy: "WP", status: "implemented", text: "Laptops and desktop devices should run the latest version of antivirus software that has been approved by IT", title: "Laptops and desktop devices should run the latest version of antivirus software...", vague: false}), (:Control {adopted: false, id: "CTRL-WP-7", policy: "WP", text: "Employees will be issued a desktop, laptop, or both by the company, based on their job duties. Contractors will provide their own laptops.", title: "Employees will be issued a desktop, laptop, or both by the company, based on...", vague: false}), (:Control {adopted: false, id: "CTRL-WP-8", policy: "WP", text: "Desktops and laptops must operate on macOS or Windows.", title: "Desktops and laptops must operate on macOS or Windows", vague: false}), (:Control {adopted: false, id: "CTRL-WP-9", policy: "WP", text: "Mobile devices must be operated as defined in the Removable Media Policy, Cloud Storage, and Bring Your Own Device Policy.", title: "Mobile devices must be operated as defined in the Removable Media Policy, Cloud...", vague: false}), (:Control {adopted: false, id: "CTRL-WP-10", policy: "WP", text: "Mobile devices must operate on iOS or Android.", title: "Mobile devices must operate on iOS or Android", vague: false}), (:Control {adopted: false, id: "CTRL-WP-11", policy: "WP", text: "Company data may only be accessed on mobile devices with Slack and Gmail.", title: "Company data may only be accessed on mobile devices with Slack and Gmail", vague: false}), (:Control {adopted: false, id: "CTRL-WP-12", policy: "WP", text: "Removable media must be operated as defined in the Removable Media Policy, Cloud Storage, and Bring Your Own Device Policy.", title: "Removable media must be operated as defined in the Removable Media Policy...", vague: false}), (:Control {adopted: false, id: "CTRL-WP-13", policy: "WP", text: "Removable media is permitted on approved devices as long as it does not conflict with other policies.", title: "Removable media is permitted on approved devices as long as it does not...", vague: false});
