# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Scratch and local-only
.scratch/
.cache/
out/
*.log
# ...but the Relate store's WAL segments are part of the committed store
!data/**/wal/*.log

# Relate auth tokens and lock files (never commit)
*.auth-token
# NOTE: .cypherlite.lock / .cypherlite.writer are NOT ignored. In Relate 1.2.0 they are static
# role markers ("CYPHERLITE-LOCK-v1 root" / "wal"), and a clone cannot open the store without them.

# Secrets
.env
.env.*
!.env.example

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated by `crosswalk agent setup` (agents/skills/ is the committed source)
.mcp.json
.mcp.json.bak
.crosswalk-setup.json
.cursor/
.claude/skills/

# Web tooling (vendored files in web/vendor are committed)
web/node_modules/
__pycache__/
